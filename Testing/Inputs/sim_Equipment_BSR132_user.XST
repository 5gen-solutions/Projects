						<linkSource parentObjectName=".20" pinName="OUT">
							<objPosition posX="27" posY="134"></objPosition>
						</linkSource>
						<linkDestination parentObjectName=".21" pinName="IN">
							<objPosition posX="39" posY="134"></objPosition>
						</linkDestination>
					</linkFB>
					<textBox width="10" height="6">Set statuses to enable opposing toggling of oOK and oFlt pins of FlexiSoftIn block
    <objPosition posX="20" posY="22"></objPosition>
					</textBox>
					<textBox width="80" height="21">(*Flexi Soft Simulation*)
(* Simulation for FlexiSoftIn and FlexiSoftOut DFB Blocks

=====Inputs=====		[TYPE]			  [DESCRIPTION]
- iOutDatDDT	:	[FlexiSoftRawOutDDT]   	  Output DDT from FlexiSoftOut Block to capture commands and watchdog
- iSysFlt		:	[EBOOL]			  Toggle output Healthy (oOK) and Fault (oFlt) statuses of FlexiSoftIn block and enables reporting fault diagnostics
- iPriOKWd1	:	[EBOOL]			  Set value for output Primary Elements Healthy Array Element 0 (oPriOKArr[0]) of FlexiSoftIn block
- iPriOKWd2	:	[EBOOL]			  Set value for output Primary Elements Healthy Array Element 1 (oPriOKArr[1]) of FlexiSoftIn block
- iPriOKWd3	:	[EBOOL]			  Set value for output Primary Elements Healthy Array Element 2 (oPriOKArr[2]) of FlexiSoftIn block
- iPriOKWd4	:	[EBOOL]			  Set value for output Primary Elements Healthy Array Element 3 (oPriOKArr[3]) of FlexiSoftIn block
- iFltAreaID	:	[EBOOL]			  Set value for output Faulted Drop Area ID (oStsDDT.FltAreaID) of FlexiSoftIn block
- iModFltSts	:	[EBOOL]			  Set value for output Faulted Drop I/O Module Fault Statuses (oStsDDT.ModFltSts) of FlexiSoftIn block
- iModChSts	:	[EBOOL]			  Set value for output Faulted Drop Faulted I/O Module Channel Healthy Statuses (oStsDDT.ModChSts) of FlexiSoftIn block
	
=====Outputs=====
- oInDatDDT	:	[FlexiSoftRawInDDT]	  Input DDT to FlexiSoftIn Block to report simulated statuses and fault diagnostics *)
    <objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="10" height="4">Fault diagnostics are only reported when the system is faulted
    <objPosition posX="20" posY="112"></objPosition>
					</textBox>
					<textBox width="10" height="3">Input Assignment from FlexiSoftOut Block
    <objPosition posX="20" posY="49"></objPosition>
					</textBox>
				</networkFBD>
			</FBDSource>
		</FBProgram>
	</FBSource>
