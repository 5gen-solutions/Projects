	<FBSource nameOfFBType="SIM_Brake" version="0.39" dateTime="dt#2024-02-12-10:19:07">
		<attribute name="TypeCodeCheckSumString" value="69B1"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="E644"></attribute>
		<inputParameters>
			<variables name="iReleaseSV" typeName="EBOOL">
				<comment>Brake Release Solenoid Output Signal</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iPmpReq" typeName="EBOOL">
				<comment>Pump Request Signal</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="iBrakePrsSP" typeName="REAL">
				<comment>Brake Pressure Lifted Setpoint (KPa)</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iBrakePrsHoldSP" typeName="REAL">
				<comment>Brake Pressure Steady State Set Point when Lifted (KPa) </comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iLiftTime" typeName="TIME">
				<comment>Time For Brake to Lift From Applied State at 0KPa (s)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iDumpTime" typeName="TIME">
				<comment>Brake Pressure Dump Time (s)</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="iFltMode" typeName="INT">
				<comment>Healthy State (0), Failed To Lift Fault (1), Failed To Apply Fault(2)</comment>
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="iRst" typeName="EBOOL">
				<comment>Reset Block to Applied (Fail Safe State)</comment>
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oLft" typeName="EBOOL">
				<comment>Brake Lifted Signal</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="oPrsLo" typeName="EBOOL">
				<comment>Brake Pressure Low Signal</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="oBrakePrs" typeName="REAL">
				<comment>Real Time Brake Pressure (KPa)</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="RAMP_0" typeName="RAMP"></variables>
			<variables name="Ramp_rate" typeName="Para_RAMP"></variables>
			<variables name="LiftTimeReal" typeName="REAL"></variables>
			<variables name="SteadyStateSP" typeName="REAL"></variables>
			<variables name="OverShootPrs" typeName="REAL"></variables>
			<variables name="ControlThreshld" typeName="REAL"></variables>
			<variables name="UnderShootPrs" typeName="REAL"></variables>
			<variables name="SetpointInst" typeName="REAL">
				<comment>Instantaneous setpoint</comment>
			</variables>
			<variables name="Dump_rate" typeName="REAL"></variables>
			<variables name="PressureLeak_rate" typeName="REAL"></variables>
		</privateLocalVariables>
		<FBProgram name="SIM_Brake">
			<STSource>(* Brake Pressure Simulation AXY 01/07/2022 *)
(* 
Simulates ramping of brake pressure. Brake has a fail-safe functionality, where brake will always be in 'applied' state when faulted.
When Conveyor start is requested, 'release solenoid valve' and 'brake pump release' signal should be true, the simulation will start
ramping of brake pressure. Once pressure reaches iBrakePresSP setpoint, brake is considered lifted and output signal turned on. 
Brake pressure will continue to rise until it reaches pressure hold setpoint. As brake pressure leaks and goes below the hold setpoint
On-Off controller signal is used to regulate the pressure at a predefined 'hold' setpoint.


Inputs:		[TYPE]	[DESCRIPTION]
iReleaseSV	[EBOOL]	Brake Release Solenoid Valve Request Bit (Output From KP brake DO: SV_O)
iPmpReq		[EBOOL]	Brake Pump Request Bit (SR_O DO signal)
iBrakePrsSP	[REAL]	Brake Pressure Setpoint for Valve to be Displayed as Lifted (KPa)
iBrakePrsHoldSP	[REAL]	Brake Pressure Steady State Setpoint, above iBrakePrsSP 
iLiftTime	[TIME]	Time for Brake Pressure to Reach iBrakePrsSP from 0 KPa (Brake Lift Time)
iDumpTime	[TIME]	Brake Pressure Dump Time from iBrakePrsSP
iFltMode	[INT]	Fault Mode: 0-&gt; Normal Operation (no fault); 1-&gt; Failed to Lift Brakes (
iRst		[EBOOL]	Reset Simulation Block while Rst is 1

Outputs:	[TYPE]	[DESCRIPTION]
oLft		[EBOOL]	Brake Lifted Signal
oPrsLo		[EBOOL]	Brake Pressure Low Signal (Brake Applied)
oBrakePrs	[REAL]	Brake Pressure Simulation (KPa)


 *)



(* START OF CODE *)

(* =====Constants===== *)
SteadyStateSP		:= iBrakePrsHoldSP			;
LiftTimeReal		:= TIME_TO_REAL (IN := iLiftTime)/1000.0; 	(* lift time to real *) 
ControlThreshld		:= (iBrakePrsHoldSP - iBrakePrsSP)* 0.5 ;
OverShootPrs		:= SteadyStateSP + ControlThreshld	;
UnderShootPrs 		:= SteadyStateSP (* - ControlThreshld *)	;


Ramp_rate.inc_rate 	:= iBrakePrsSP / LiftTimeReal		;
PressureLeak_rate 	:= Ramp_rate.inc_rate* 0.01		; 	(*brake pressure leak simulation*)
Dump_rate		:= iBrakePrsHoldSP/TIME_TO_REAL (IN := iDumpTime)*1000.0 ; (* Pressure Dump rate is 1000 times increase rate  *)




(* =====Ramp Logic===== *)


IF NOT iReleaseSV THEN (* Brake Applied State AND dump brake*)
	SetPointInst	:= 0.0;
	Ramp_rate.dec_rate	:= Dump_rate;

ELSIF iReleaseSV  THEN
	Ramp_rate.dec_rate	:= PressureLeak_rate;

	if iPmpReq then(* Request Brake Lifted *)
		SetPointInst	:= OvershootPrs;
	elsif oBrakePrs &gt;= OverShootPrs then		(* ON OFF CONTROL =&gt; *)(* IF AT OVERSHOOT *)
		SetPointInst 	:= UnderShootPrs;
		(* IF AT UNDERSHOOT *)
	elsif oBrakePrs &lt;= UnderShootPrs THEN;
		SetpointInst	:= OverShootPrs;
		 
	end_if;
END_IF;	



(* =====Ramp Sim===== *)
RAMP_0 (RSP  := SetpointInst,
        PARA := Ramp_rate,
        TR_I := 0.0,
        TR_S := 0,
        SP =&gt; oBrakePrs );

(* =====Output Assignment===== *)
CASE iFltMode OF 
1: (* failed to lift / brake still applied*)
	oLft 	:= FALSE;
	oPrsLo	:= TRUE;
	
2: (* failed to apply/ ie lifted *)
	oLft	:= TRUE;
	(* oPrsLo	:= FALSE; *)

ELSE (* Normal operation *)
	if iReleaseSV then
		IF oBrakePrs &gt;= iBrakePrsSP THEN
			oLft 	:= TRUE;
		END_IF;
		IF oBrakePrs &gt; SteadyStateSP THEN
			oPrsLo	:= False;
		(* ELSIF oBrakePrs  *)
		ELSIF oBrakePrs &lt; iBrakePrsSP THEN 	
			oPrsLo	:= TRUE;
			oLft	:= FALSE;
		END_IF;
	else
		oPrsLo	:= TRUE;
		oLft	:= FALSE;
	
	end_if;
END_CASE;

IF iRst THEN  
	oLft  := False;
	oPrsLo:= True;
	oBrakePrs := 0.0;
END_IF; 



(* END OF CODE *)
</STSource>
		</FBProgram>
	</FBSource>
