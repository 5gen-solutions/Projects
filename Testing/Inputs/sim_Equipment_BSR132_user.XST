	<FBSource nameOfFBType="sim_CBSts" version="0.15" dateTime="dt#2024-02-12-10:19:03">
		<comment>Circuit Breaker Sim Block (All output are mutually exclusive)</comment>
		<attribute name="TypeCodeCheckSumString" value="92D8"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="9511"></attribute>
		<inOutParameters>
			<variables name="ioSetTripped" typeName="EBOOL">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="ioReset" typeName="EBOOL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="ioSetOpen" typeName="EBOOL">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="oClsd" typeName="EBOOL">
				<comment>Circuit Breaker Closed Status (1 = Closed)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="oTrpd" typeName="EBOOL">
				<comment>Circuit Breaker Tripped Status (1 = Tripped)</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="SetTrip" typeName="EBOOL">
				<comment>Local Set Trip Status Bit (1 = Set Trip)</comment>
			</variables>
			<variables name="SetOpen" typeName="EBOOL">
				<comment>Local Set Open Status bit (1 = Set Open)</comment>
			</variables>
			<variables name="TON_0" typeName="TON"></variables>
			<variables name="ResetCB" typeName="EBOOL">
				<comment>Reset Circuit Breaker Status</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="sim_CBStatus">
			<STSource>(* Reset IO to 0 *)
SetTrip := MOVE (IN := ioSetTripped );
ioSetTripped := MOVE (IN := 0 );

SetOpen := MOVE (IN := ioSetOpen);
ioSetOpen := MOVE (IN := 0 );

TON_0 (IN := ioReset,
       PT := t#1s,
       Q =&gt; ResetCB);

IF ioReset THEN
	oTrpd := 0;
	oClsd := 0;
END_IF;

IF ResetCB OR %s21 THEN 
	ioReset := 0;
	oTrpd := 0;
	oClsd := 1;
END_IF;






IF SetTrip THEN
	oTrpd := 1;
	oClsd := 0;
END_IF;



IF SetOpen THEN 	
	oTrpd := 0;
	oClsd := 0;
END_IF;
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="sim_AHI_Scale" version="0.21" dateTime="dt#2024-05-20-14:29:47">
		<attribute name="TypeCodeCheckSumString" value="2381"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="7F26"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="iMax" typeName="REAL">
				<comment>Max PV Eng Out Value </comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iMin" typeName="REAL">
				<comment>Min PV Eng Out</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iRand_LL" typeName="REAL">
				<comment>Lower Random Number Limit</comment>
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="iRand_UL" typeName="REAL">
				<comment>Upper Random Number imit</comment>
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
			<variables name="iFrzVal" typeName="EBOOL">
				<comment>Remove Random Number Modifier</comment>
				<attribute name="PositionPin" value="10"></attribute>
			</variables>
			<variables name="iEngMin" typeName="REAL">
				<comment>Eng Min for Scaling (=0)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iEngMax" typeName="REAL">
				<comment>Eng Max for Scaling to raw (=10000)</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="iOvrPV" typeName="REAL">
				<comment>Override PV number if OvrPV not equal to 0</comment>
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="ioPV" typeName="REAL">
				<comment>input PV from simulation (eng units)</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="oPVEng" typeName="REAL">
				<comment>Simulated PV Eng Units</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="oPVPer" typeName="REAL">
				<comment>Simulated Raw value 0-100% of scale</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="Simulation_Random_Number_0" typeName="Simulation_Random_Number"></variables>
			<variables name="Rand_Num" typeName="REAL">
				<comment>Random Number</comment>
			</variables>
			<variables name="RawMin" typeName="REAL">
				<comment>Raw Min for AI scaling</comment>
			</variables>
			<variables name="RawMax" typeName="REAL">
				<comment>Raw Max for AI Scaling</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="sim_AHI_Scale">
			<STSource>(*------------------------------------------------------------------------------

ANALOG SCALING SIMULATION

ioPV		Process value in Engineering Units (ms-1, L/s, etc..)

iMin		Process value minimum
iMax		Process value maximum
iEngMax		Engineering Value Maximum
iEngMin		Engineer Value Minimum
iOvrPV		Override Process Value when iOvrPV &lt;&gt; 0 
iRand_xL	Upper and lower random number limits - 0 = no random number

23/11/2023 	AXY -  Sim analog scaling block; derived from PROC_Linear DFB
------------------------------------------------------------------------------*)

(* always calculate random number for use *)
Simulation_Random_Number_0 (LowerLimit := iRand_LL,
                            UpperLimit := iRand_UL,
                            RandomNumber =&gt; Rand_Num);
(* Override Sim Process Value *)
IF iOvrPV &lt;&gt; 0.0 THEN
	ioPV := LIMIT (
		MN := iMin,
		IN := iOvrPV,
		MX := iMax
		);
END_IF;

(* Add + Enable/Disable Random Number *)
IF iFrzVal THEN
	oPVEng := ioPV;
ELSE
	oPVEng := ioPV + Rand_Num;
END_IF;

(* calculate raw value for AI mapping block AS A % *)
RawMax := 100.0;
RawMin := 0.0;
oPVPer := RawMin + (oPVEng - iEngMin)*(RawMax - RawMin)/(iEngMax - iEngMin);
</STSource>
		</FBProgram>
	</FBSource>
