	<FBSource nameOfFBType="sim_rex640" version="0.27" dateTime="dt#2024-08-13-10:14:57">
		<comment>REX640 Protection Relay Sim Block</comment>
		<attribute name="TypeCodeCheckSumString" value="7D97"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="6A25"></attribute>
		<inputParameters>
			<variables name="iFlt" typeName="EBOOL">
				<comment>Trigger Internal Fault</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iVolts" typeName="REAL">
				<comment>Simulate Nominal Voltage</comment>
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
			<variables name="iIn" typeName="REAL">
				<comment>Relay Primary Current Setting (A)</comment>
				<attribute name="PositionPin" value="11"></attribute>
			</variables>
			<variables name="iUn" typeName="REAL">
				<comment>Relay Primary Voltage Setting (kV)</comment>
				<attribute name="PositionPin" value="10"></attribute>
			</variables>
			<variables name="iAmps" typeName="REAL">
				<comment>Simulate Nominal Amperage</comment>
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
			<variables name="iFunSts" typeName="WORD">
				<comment>Simulate Function Statuses</comment>
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="iSlotBDI" typeName="WORD">
				<comment>Simulate Slot B Digital Inputs</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="iSlotCDI" typeName="WORD">
				<comment>Simulate Slot C Digital Inputs</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iSlotBDO" typeName="WORD">
				<comment>Simulate Slot B Digital Outputs</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iSlotCDO" typeName="WORD">
				<comment>Simulate Slot C Digital Outputs</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iSlotGDIO" typeName="WORD">
				<comment>Simulate Slot G Digital Input/Outputs</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oDatDDT" typeName="REX640RawInDDT">
				<comment>REX640 Input DDT</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="WDcounter_int" typeName="INT">
				<comment>Watchdog Counter (ms)</comment>
			</variables>
			<variables name="CTU_0" typeName="CTU">
				<comment>watchdog counter</comment>
			</variables>
			<variables name="FltID" typeName="INT">
				<comment>Fault ID</comment>
			</variables>
			<variables name="WrnID" typeName="INT">
				<comment>Warning ID</comment>
			</variables>
			<variables name="Volt_Scaled_Real" typeName="REAL">
				<comment>Scaled Voltage Value</comment>
			</variables>
			<variables name="Amps_Scaled_Real" typeName="REAL">
				<comment>Scaled Current Value</comment>
			</variables>
			<variables name="Rex640_AnaScale" typeName="REAL">
				<comment>REX640 internal analog value scaling</comment>
			</variables>
			<variables name="Current_HiWORD" typeName="WORD">
				<comment>Current High Word</comment>
			</variables>
			<variables name="Current_LoWORD" typeName="WORD">
				<comment>Current Low Word</comment>
			</variables>
			<variables name="Volt_LoWORD" typeName="WORD">
				<comment>Voltage Low WORD</comment>
			</variables>
			<variables name="Volt_HiWORD" typeName="WORD">
				<comment>Voltage High Word</comment>
			</variables>
			<variables name="pf" typeName="REAL">
				<comment>Power Factor</comment>
			</variables>
			<variables name="PwrAct_Scaled_real" typeName="REAL">
				<comment>Scaled Active Power (kW)</comment>
			</variables>
			<variables name="PwrAct_HiWORD" typeName="WORD">
				<comment>Active Power High Word</comment>
			</variables>
			<variables name="PwrAct_LoWORD" typeName="WORD">
				<comment>Active Power Low Word</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="sim_rex640">
			<STSource>(* =====REX640 SIMULATION BLOCK===== *)
(* This block simulates ABB REX640 Protection Relay Data
- Simulate Voltage and Current Analogs
- Simulate Hard wired inputs to the REX
- Simulate Functional Statuses Dependent on the REX User Mapping
- Simulate Internal Fault, Fault and Warning IDs

- Comms and PLM Statuses should be set through the REX640 Interface block

Note Refer to REX640 DFB and Documents for internal function mapping
Note REX640 unit flips analog INT values around 

2023 July 20 - AXY
 *)



(* -----Simulate Internal Watchdog - SSR5----- *)
CTU_0 (CU := %s5,
        R := WDCounter_Int &gt; 32766, (* limit int 32767 *)
        CV =&gt; WDcounter_int ); 

oDatDDT.Free[44] := WDCounter_Int;



(* -----Simulate Faults----- *)
oDatDDT.Free[40].1 := FALSE;  	(* Global Error *)
oDatDDT.Free[4].15 := iFlt; 	(* Simulate Internal Fault *)

(* -----Generate Fault/Warning Codes----- *)
IF iFlt THEN 
	FltID := 8;	(* internal fault *)
	WrnID := 1; 	(* healthy warning code*)

ELSE
	FltID := 1; 	(* healthy *)
	WrnID := 1; 	(* healthy *)
END_IF;

oDatDDT.Free[32] := FltID; 
oDatDDT.Free[33] := WrnID;


(* -----Simulate Analog Values----- *)
(* note that the INTs are flipped around in the REX (High Endian Format) *)

Rex640_AnaScale  := 1000.0;

(* Current (A)*)
Amps_Scaled_Real := (iAmps/iIn)*Rex640_AnaScale;

DINT_AS_WORD (IN := (REAL_TO_DINT (IN := Amps_Scaled_Real)),
              LOW =&gt;  Current_LoWORD,
              HIGH =&gt; Current_HiWORD);
	(* Ia *)
oDatDDT.Free[13] := WORD_TO_INT (IN := Current_HiWORD);
oDatDDT.Free[12] := WORD_TO_INT (IN := Current_LoWORD);
	(* Ib *)
oDatDDT.Free[15] := WORD_TO_INT (IN := Current_HiWORD);
oDatDDT.Free[14] := WORD_TO_INT (IN := Current_LoWORD);
	(* Ic *)
oDatDDT.Free[17] := WORD_TO_INT (IN := Current_HiWORD);
oDatDDT.Free[16] := WORD_TO_INT (IN := Current_LoWORD );

(* Voltage (kV)*)
Volt_Scaled_Real := (iVolts/iUn)*Rex640_AnaScale;

DINT_AS_WORD (IN := (REAL_TO_DINT (IN := Volt_Scaled_Real)),
              LOW =&gt;  Volt_LoWORD,
              HIGH =&gt; Volt_HiWORD);
	(* L1L2V *)
oDatDDT.Free[19] := WORD_TO_INT (IN := Volt_HiWORD);
oDatDDT.Free[18] := WORD_TO_INT (IN := Volt_LoWORD );
	(* L2L3V *)
oDatDDT.Free[21] := WORD_TO_INT (IN := Volt_HiWORD);
oDatDDT.Free[20] := WORD_TO_INT (IN := Volt_LoWORD );
	(* L2L3V *)
oDatDDT.Free[23] := WORD_TO_INT (IN := Volt_HiWORD);
oDatDDT.Free[22] := WORD_TO_INT (IN := Volt_LoWORD );



(* Power = Volt*Amps (kW) *)

PwrAct_Scaled_real := iVolts * iAmps;

DINT_AS_WORD (IN := (REAL_TO_DINT (IN := PwrAct_Scaled_real)),
              LOW =&gt;  PwrAct_LoWORD,
              HIGH =&gt; PwrAct_HiWORD);
	(* Active Power *)
oDatDDT.Free[25] := WORD_TO_INT (IN := PwrAct_HiWORD);
oDatDDT.Free[24] := WORD_TO_INT (IN := PwrAct_LoWORD );


(* Freq *)
oDatDDT.Free[31]	:= WORD_TO_INT ( IN:= DINT_TO_WORD( IN:= REAL_TO_DINT (IN :=  REX640_AnaScale * 50.0))); 

(* PF *)
pf := 0.9;

oDatDDT.Free[30] :=  REAL_TO_INT (IN := pf * Rex640_AnaScale);

(* Calculate Reactive Power *)


(* Calculate Apparent Power *)


(* ------Slot Simulation And Function Status----- *)
oDatDDT.Free[0].0	:=	iSlotBDI.0	;
oDatDDT.Free[0].2	:=	iSlotBDI.1	;
oDatDDT.Free[0].4	:=	iSlotBDI.2	;
oDatDDT.Free[0].6	:=	iSlotBDI.3	;
oDatDDT.Free[0].8	:=	iSlotBDI.4	;
oDatDDT.Free[0].10	:=	iSlotBDI.5	;
oDatDDT.Free[0].12	:=	iSlotBDI.6	;
oDatDDT.Free[0].14	:=	iSlotBDI.7	;
oDatDDT.Free[1].0	:=	iSlotBDI.8	;
oDatDDT.Free[1].2	:=	iSlotBDI.9	;
oDatDDT.Free[1].4	:=	iSlotBDI.10	;
oDatDDT.Free[1].6	:=	iSlotBDI.11	;
oDatDDT.Free[1].8	:=	iSlotBDI.12	;
oDatDDT.Free[1].10	:=	iSlotBDI.13	;
oDatDDT.Free[1].12	:=	iSlotCDI.0	;
oDatDDT.Free[1].14	:=	iSlotCDI.1	;
oDatDDT.Free[2].0	:=	iSlotCDI.2	;
oDatDDT.Free[2].2	:=	iSlotCDI.3	;
oDatDDT.Free[2].4	:=	iSlotCDI.4	;
oDatDDT.Free[2].6	:=	iSlotCDI.5	;
oDatDDT.Free[2].8	:=	iSlotCDI.6	;
oDatDDT.Free[2].10	:=	iSlotCDI.7	;
oDatDDT.Free[2].12	:=	iSlotCDI.8	;
oDatDDT.Free[2].14	:=	iSlotCDI.9	;
oDatDDT.Free[3].0	:=	iSlotCDI.10	;
oDatDDT.Free[3].2	:=	iSlotCDI.11	;
oDatDDT.Free[3].4	:=	iSlotCDI.12	;
oDatDDT.Free[3].6	:=	iSlotCDI.13	;
oDatDDT.Free[3].8	:=	iSlotGDIO.0	;
oDatDDT.Free[3].10	:=	iSlotGDIO.1	;
oDatDDT.Free[3].12	:=	iSlotGDIO.2	;
(* oDatDDT.Free[3].14	:=		; *)
oDatDDT.Free[4].0	:=	iFunSts.0	;
oDatDDT.Free[4].2	:=	iFunSts.1	;
oDatDDT.Free[4].4	:=	iFunSts.4	;
oDatDDT.Free[4].6	:=	iFunSts.5	;
oDatDDT.Free[4].8	:=	iFunSts.6	;
oDatDDT.Free[4].10	:=	iFunSts.7	;
(* oDatDDT.Free[4].12	:=	 	;
oDatDDT.Free[4].14	:=		;  *)
oDatDDT.Free[5].0	:=	iFunSts.8	;
oDatDDT.Free[5].2	:=	iFunSts.9	;
oDatDDT.Free[5].4	:=	iFunSts.10	;
oDatDDT.Free[5].6	:=	iFunSts.11	;
oDatDDT.Free[5].8	:=	iFunSts.12	;
oDatDDT.Free[5].10	:=	iFunSts.13	;
oDatDDT.Free[5].12	:=	iFunSts.14	;
oDatDDT.Free[5].14	:=	iFunSts.15	;
oDatDDT.Free[6].0	:=	iFunSts.2	;
oDatDDT.Free[6].2	:=	iFunSts.3	;
(* oDatDDT.Free[6].4	:=		;
oDatDDT.Free[6].6	:=		;
oDatDDT.Free[6].8	:=		;
oDatDDT.Free[6].10	:=		;
oDatDDT.Free[6].12	:=		;
oDatDDT.Free[6].14	:=		; *)
oDatDDT.Free[7].0	:=	iSlotBDO.0	;
oDatDDT.Free[7].2	:=	iSlotBDO.1	;
oDatDDT.Free[7].4	:=	iSlotBDO.2	;
oDatDDT.Free[7].6	:=	iSlotBDO.3	;
oDatDDT.Free[7].8	:=	iSlotBDO.4	;
oDatDDT.Free[7].10	:=	iSlotBDO.5	;
oDatDDT.Free[7].12	:=	iSlotBDO.6	;
oDatDDT.Free[7].14	:=	iSlotBDO.7	;
oDatDDT.Free[8].0	:=	iSlotCDO.0	;
oDatDDT.Free[8].2	:=	iSlotCDO.1	;
