<STExchangeFile>
	<fileHeader company="Schneider Automation" product="Control Expert V16.2 - 250430" dateTime="date_and_time#2026-9-8-3:41:13" content="Structured source file" DTDVersion="41"></fileHeader>
	<contentHeader name="BPL132" version="0.0.202" dateTime="date_and_time#2026-7-1-10:24:18"></contentHeader>
	<program>
		<identProgram name="sim_PLC_module" type="section" task="MAST" SectionOrder="4"></identProgram>
		<STSource>(* Head Rack Modules Simulation
CRA Modules Simulation *)

IF sim_SetHealthy THEN


	(* =========== HEAD RACK =========== *)
	(* Set PLC Links Healthy *)
	sim_BPL132PLM0_Mode := 1;(* set ethernet 1 to active (service port) *)
	SIM_BMEP586x4xRIO_0 (iMode := Sim_BPL132PLM0_Mode,
	                     iFlt := Sim_BPL132PLM0_Flt,
	                     iLnkNotAct := Sim_BPL132PLM0_LnkFlt,
	                     oInDatDDT =&gt; BMEP58_ECPU_EXT);
	(* ===== NOC Sim ===== *)
	IF Sim_BPL132PLM3_Mode = 1 THEN(* set ethernet 1 to active (service port) *)
	sim_noc0301_0 (iMode 	:= Sim_BPL132PLM3_Mode,
               		iFlt 	:= Sim_BPL132PLM3_Flt,
               		iComFlt := Sim_BPL132PLM3_ComFlt,
               		iLnkNotAct := Sim_BPL132PLM3_LnkFlt,
               		oInDatDDT =&gt; PLC_3);		
	END_IF;
	IF Sim_BPL132PLM4_Mode = 1 THEN(* set ethernet 1 to active (service port) *)
	sim_noc0301_1 (iMode 	:= Sim_BPL132PLM4_Mode,
               		iFlt 	:= Sim_BPL132PLM4_Flt,
               		iComFlt := Sim_BPL132PLM4_ComFlt,
               		iLnkNotAct := Sim_BPL132PLM4_LnkFlt,
               		oInDatDDT =&gt; HMI_4);		
	END_IF;
	Sim_BPL132PLM5_Mode := 1;(* set ethernet 1 to active (service port) *)
	sim_noc0301_2 (iMode := Sim_BPL132PLM5_Mode,
	               iFlt := Sim_BPL132PLM5_Flt,
		       iComFlt 	:= Sim_BPL132PLM5_ComFlt,
	               iLnkNotAct := Sim_BPL132PLM5_LnkFlt,
	               oInDatDDT =&gt; IO_5);

	(* =========== BSR132DX01DIO1PLM0 - DROP 1 =========== *)
	SIM_CRA31210_1 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= Sim_BSR132DX01DIO1PLM0_Flt,
                     iComFlt 	:= Sim_BSR132DX01DIO1PLM0_ComFlt,
                     iLnkNotAct := Sim_BSR132DX01DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D01R00S00); 

	(* =========== BBD131DX03DIO1PLM0 - DROP 3 =========== *)
	SIM_CRA31210_3 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= Sim_BBD131DX03DIO1PLM0_Flt,
                     iComFlt 	:= Sim_BBD131DX03DIO1PLM0_ComFlt,
                     iLnkNotAct := Sim_BBD131DX03DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D03R00S00); 

	(* =========== BBD131DX04DIO1PLM0 - DROP 4 =========== *)
	SIM_CRA31210_4 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= Sim_BBD131DX04DIO1PLM0_Flt,
                     iComFlt 	:= Sim_BBD131DX04DIO1PLM0_ComFlt,
                     iLnkNotAct := Sim_BBD131DX04DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D04R00S00); 

	(* =========== BBD131DX05DIO1PLM0 - DROP 5 =========== *)
	SIM_CRA31210_5 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= Sim_BBD131DX05DIO1PLM0_Flt,
                     iComFlt 	:= Sim_BBD131DX05DIO1PLM0_ComFlt,
                     iLnkNotAct := Sim_BBD131DX05DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D05R00S00); 

	(* =========== BCV131DX06DIO1PLM0 - DROP 6 =========== *)
	SIM_CRA31210_6 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= Sim_BCV131DX06DIO1PLM0_Flt,
                     iComFlt 	:= Sim_BCV131DX06DIO1PLM0_ComFlt,
                     iLnkNotAct := Sim_BCV131DX06DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D06R00S00); 

	(* =========== CV702DX07DIO1PLM0 - DROP 7 =========== *)
	SIM_CRA31210_7 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= Sim_CV702DX07DIO1PLM0_Flt,
                     iComFlt 	:= Sim_CV702DX07DIO1PLM0_ComFlt,
                     iLnkNotAct := Sim_CV702DX07DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D07R00S00); 

	(* =========== BCV131DX08DIO1PLM0 - DROP 8 =========== *)
	SIM_CRA31210_8 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= Sim_BCV131DX08DIO1PLM0_Flt,
                     iComFlt 	:= Sim_BCV131DX08DIO1PLM0_ComFlt,
                     iLnkNotAct := Sim_BCV131DX08DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D08R00S00); 

	(* =========== BCV131DX09DIO1PLM0 - DROP 9 =========== *)
	SIM_CRA31210_9 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= Sim_BCV131DX09DIO1PLM0_Flt,
                     iComFlt 	:= Sim_BCV131DX09DIO1PLM0_ComFlt,
                     iLnkNotAct := Sim_BCV131DX09DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D09R00S00); 

	(* =========== BCV131DX10DIO1PLM0 - DROP 10 =========== *)
	SIM_CRA31210_10 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= Sim_BCV131DX10DIO1PLM0_Flt,
                     iComFlt 	:= Sim_BCV131DX10DIO1PLM0_ComFlt,
                     iLnkNotAct := Sim_BCV131DX10DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D10R00S00); 

	(* =========== BCV131DX11DIO1PLM0 - DROP 11 =========== *)
	SIM_CRA31210_11 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= Sim_BCV131DX11DIO1PLM0_Flt,
                     iComFlt 	:= Sim_BCV131DX11DIO1PLM0_ComFlt,
                     iLnkNotAct := Sim_BCV131DX11DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D11R00S00); 

	(* =========== BCV131DX12DIO1PLM0 - DROP 12 =========== *)
	SIM_CRA31210_12 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= Sim_BCV131DX12DIO1PLM0_Flt,
                     iComFlt 	:= Sim_BCV131DX12DIO1PLM0_ComFlt,
                     iLnkNotAct := Sim_BCV131DX12DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D12R00S00); 
end_if;
</STSource>
	</program>
