	<FBSource nameOfFBType="SIM_X80DDI3202K" version="0.18" dateTime="dt#2024-02-12-10:19:03">
		<comment>Simulates X80 32 Channel Digital input module statuses</comment>
		<attribute name="TypeCodeCheckSumString" value="0067"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="CC58"></attribute>
		<inputParameters>
			<variables name="iModFlt" typeName="EBOOL">
				<comment>Simulate Module Fault</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iGrp1Flt" typeName="EBOOL">
				<comment>Simulate Group 1 Fault</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="iGrp2Flt" typeName="EBOOL">
				<comment>Simulate Group 2 Fault</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iGrp1WordHty" typeName="WORD">
				<comment>Channel 00-15 Healthy State simulation word (1= bit healthy)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iGrp2WordHty" typeName="WORD">
				<comment>Channel 16-31 Healthy State simulation word (1= bit healthy)</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oInDatDDT" typeName="T_U_DIS_STD_IN_32">
				<comment>DDT of Actual Signals Data Read from DDI Module</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<FBProgram name="sim_X80DDI3202K">
			<STSource>(* =====Sim X80DDI3202K Module===== 
Simulates X80 32 Channel Digital input module statuses.
Simulation of each Digital Input variable is to be packed and read as data type 'WORD' through this sim DFB

 -----Inputs----- 
INPUT		TYPE		DESCRIPTION 
iModFlt		EBOOL		Simulate DDI Module Fault (1= Faulted)
iGrp1Flt	EBOOL		Simulate Group 1 Fault (1= Faulted)
iGrp2Flt	EBOOL		Simulate Group 2 Fault (1= Faulted)
iGrp1WordHty	WORD		Channel 00-15 Healthy State simulation word (1= bit healthy)
iGrp2WordHty	WORD		Channel 16-31 Healthy State simulation word (1= bit healthy)

-----Outputs-----
OUTPUT 		TYPE 			DESCRIPTION
oInDatDDT	T_U_DIS_STD_IN_32	DDT of Actual Signals Data Read from DDI Module	

Toggling iModFlt will zero all Digital input variables in the corresponding DDI1602 DFB.
Toggling oGrp1Flt will zero digital input variables from Channel 00-15 (assuming iModFlt=0)
Toggling oGrp2Flt will zero digital input variables from Channel 16-31 (assuming iModFlt=0)

created: AXY 17/10/2022
*)

(*=====Digital Input Mapping=====*)

(* Group 1 DDI *)
oInDatDDT.DIS_CH_IN[0].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.0);
oInDatDDT.DIS_CH_IN[1].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.1);
oInDatDDT.DIS_CH_IN[2].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.2);
oInDatDDT.DIS_CH_IN[3].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.3);
oInDatDDT.DIS_CH_IN[4].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.4);
oInDatDDT.DIS_CH_IN[5].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.5);
oInDatDDT.DIS_CH_IN[6].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.6);
oInDatDDT.DIS_CH_IN[7].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.7);
oInDatDDT.DIS_CH_IN[8].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.8);
oInDatDDT.DIS_CH_IN[9].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.9);
oInDatDDT.DIS_CH_IN[10].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.10);
oInDatDDT.DIS_CH_IN[11].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.11);
oInDatDDT.DIS_CH_IN[12].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.12);
oInDatDDT.DIS_CH_IN[13].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.13);
oInDatDDT.DIS_CH_IN[14].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.14);
oInDatDDT.DIS_CH_IN[15].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp1WordHty.15);

(* Group 2 DDI *)
oInDatDDT.DIS_CH_IN[16].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.0);
oInDatDDT.DIS_CH_IN[17].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.1);
oInDatDDT.DIS_CH_IN[18].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.2);
oInDatDDT.DIS_CH_IN[19].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.3);
oInDatDDT.DIS_CH_IN[20].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.4);
oInDatDDT.DIS_CH_IN[21].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.5);
oInDatDDT.DIS_CH_IN[22].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.6);
oInDatDDT.DIS_CH_IN[23].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.7);
oInDatDDT.DIS_CH_IN[24].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.8);
oInDatDDT.DIS_CH_IN[25].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.9);
oInDatDDT.DIS_CH_IN[26].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.10);
oInDatDDT.DIS_CH_IN[27].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.11);
oInDatDDT.DIS_CH_IN[28].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.12);
oInDatDDT.DIS_CH_IN[29].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.13);
oInDatDDT.DIS_CH_IN[30].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.14);
oInDatDDT.DIS_CH_IN[31].VALUE:= WRITE_INPUT_EBOOL (INP :=  iGrp2WordHty.15); 

(* Group 1 Channel Healthy *)
(* Set to always healthy, turning off one of the following status bits will result in a group fault *)
oInDatDDT.DIS_CH_IN[0].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[1].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[2].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[3].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[4].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[5].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[6].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[7].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[8].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[9].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[10].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[11].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[12].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[13].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[14].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[15].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);

(* Group 2 Channel Healthy *)
(* Set to always healthy, turning off one of the following status bits will result in a group fault *)
oInDatDDT.DIS_CH_IN[16].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[17].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[18].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[19].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[20].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[21].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[22].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[23].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[24].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[25].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[26].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[27].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[28].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[29].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[30].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE);
oInDatDDT.DIS_CH_IN[31].CH_HEALTH := WRITE_INPUT_EBOOL (INP :=  TRUE); 




(*=====Mapping Outputs===== *)
(* Toggle Module Fault *)
oInDatDDT.MOD_FLT.0 			:= WRITE_INPUT_EBOOL (INP := iModFlt );
oInDatDDT.MOD_HEALTH			:= WRITE_INPUT_EBOOL (INP := TRUE ); (* always healthy *)

(* Toggle Group 1 Fault *)
oInDatDDT.DIS_CH_IN[15].CH_HEALTH 	:= WRITE_INPUT_EBOOL (INP :=  NOT(iGrp1Flt));

(* Toggle Group 2 Fault *)
oInDatDDT.DIS_CH_IN[31].CH_HEALTH 	:= WRITE_INPUT_EBOOL (INP :=  NOT(iGrp2Flt));
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="sim_X80AHI0812" version="0.05" dateTime="dt#2024-02-12-10:19:03">
		<comment>Simulation X80 BME AHI0812 8 Channel HART Analogue Input Module</comment>
		<attribute name="TypeCodeCheckSumString" value="FAAD"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="0AA8"></attribute>
		<inputParameters>
			<variables name="iModFlt" typeName="EBOOL">
				<comment>Module Fault</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iCh0Flt" typeName="INT">
				<comment>0=Healthy, 1=Channel Flt, 2=OverCurrent, 3=UnderCurrent</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="iCh0PV" typeName="REAL">
				<comment>Sim PV Scale 0-100</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iCh1Flt" typeName="INT">
				<comment>0=Healthy, 1=Channel Flt, 2=OverCurrent, 3=UnderCurrent</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iCh1PV" typeName="REAL">
				<comment>Sim PV Scale 0-100</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iCh2Flt" typeName="INT">
				<comment>0=Healthy, 1=Channel Flt, 2=OverCurrent, 3=UnderCurrent</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="iCh2PV" typeName="REAL">
				<comment>Sim PV Scale 0-100</comment>
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="iCh3Flt" typeName="INT">
				<comment>0=Healthy, 1=Channel Flt, 2=OverCurrent, 3=UnderCurrent</comment>
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
			<variables name="iCh3PV" typeName="REAL">
				<comment>Sim PV Scale 0-100</comment>
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
			<variables name="iCh4Flt" typeName="INT">
				<comment>0=Healthy, 1=Channel Flt, 2=OverCurrent, 3=UnderCurrent</comment>
				<attribute name="PositionPin" value="10"></attribute>
			</variables>
			<variables name="iCh4PV" typeName="REAL">
				<comment>Sim PV Scale 0-100</comment>
				<attribute name="PositionPin" value="11"></attribute>
			</variables>
			<variables name="iCh5Flt" typeName="INT">
				<comment>0=Healthy, 1=Channel Flt, 2=OverCurrent, 3=UnderCurrent</comment>
				<attribute name="PositionPin" value="12"></attribute>
			</variables>
			<variables name="iCh5PV" typeName="REAL">
				<comment>Sim PV Scale 0-100</comment>
				<attribute name="PositionPin" value="13"></attribute>
			</variables>
			<variables name="iCh6Flt" typeName="INT">
				<comment>0=Healthy, 1=Channel Flt, 2=OverCurrent, 3=UnderCurrent</comment>
				<attribute name="PositionPin" value="14"></attribute>
			</variables>
			<variables name="iCh6PV" typeName="REAL">
				<comment>Sim PV Scale 0-100</comment>
				<attribute name="PositionPin" value="15"></attribute>
			</variables>
			<variables name="iCh7Flt" typeName="INT">
				<comment>0=Healthy, 1=Channel Flt, 2=OverCurrent, 3=UnderCurrent</comment>
				<attribute name="PositionPin" value="16"></attribute>
			</variables>
			<variables name="iCh7PV" typeName="REAL">
				<comment>Sim PV Scale 0-100</comment>
				<attribute name="PositionPin" value="17"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oStsDDT" typeName="T_U_ANA_STD_IN_8">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="Code" typeName="INT"></variables>
			<variables name="i" typeName="INT"></variables>
			<variables name="FltCodeArr" typeName="ARRAY[0..7] OF INT"></variables>
		</privateLocalVariables>
		<FBProgram name="sim_X80AHI0812">
			<STSource>(* Toggle Module Fault *)
oStsDDT.MOD_FLT.0 			:= WRITE_INPUT_EBOOL (INP := iModFlt );
oStsDDT.MOD_HEALTH			:= WRITE_INPUT_EBOOL (INP := TRUE ); (* always healthy *)

FltCodeArr[0] := iCh0Flt;
FltCodeArr[1] := iCh1Flt;
FltCodeArr[2] := iCh2Flt;
FltCodeArr[3] := iCh3Flt;
FltCodeArr[4] := iCh4Flt;
FltCodeArr[5] := iCh5Flt;
FltCodeArr[6] := iCh6Flt;
FltCodeArr[7] := iCh7Flt;

FOR i:= 0 TO 7 DO
	Code := FltCodeArr[i];

CASE Code OF

	1	:	oStsDDT.ANA_CH_IN[i].CH_HEALTH		:= WRITE_INPUT_EBOOL (INP := FALSE );
			oStsDDT.ANA_CH_IN[i].UPPER_LIMIT	:= WRITE_INPUT_EBOOL (INP := FALSE );
			oStsDDT.ANA_CH_IN[i].LOWER_LIMIT	:= WRITE_INPUT_EBOOL (INP := FALSE );

	2	:	oStsDDT.ANA_CH_IN[i].CH_HEALTH		:= WRITE_INPUT_EBOOL (INP := FALSE );
			oStsDDT.ANA_CH_IN[i].UPPER_LIMIT	:= WRITE_INPUT_EBOOL (INP := TRUE );
			oStsDDT.ANA_CH_IN[i].LOWER_LIMIT	:= WRITE_INPUT_EBOOL (INP := FALSE );

	3	:	oStsDDT.ANA_CH_IN[i].CH_HEALTH		:= WRITE_INPUT_EBOOL (INP := FALSE );
			oStsDDT.ANA_CH_IN[i].UPPER_LIMIT	:= WRITE_INPUT_EBOOL (INP := FALSE );
			oStsDDT.ANA_CH_IN[i].LOWER_LIMIT	:= WRITE_INPUT_EBOOL (INP := TRUE );

  ELSE
	oStsDDT.ANA_CH_IN[i].CH_HEALTH		:= WRITE_INPUT_EBOOL (INP := TRUE );
	oStsDDT.ANA_CH_IN[i].UPPER_LIMIT	:= WRITE_INPUT_EBOOL (INP := FALSE );
	oStsDDT.ANA_CH_IN[i].LOWER_LIMIT	:= WRITE_INPUT_EBOOL (INP := FALSE );
END_CASE;

END_FOR;

oStsDDT.ANA_CH_IN[0].ANA.TRUE_VALUE := WRITE_INPUT_INT (INP := REAL_TO_INT (iCh0PV * 100.0));
oStsDDT.ANA_CH_IN[1].ANA.TRUE_VALUE := WRITE_INPUT_INT (INP := REAL_TO_INT (iCh1PV * 100.0));
oStsDDT.ANA_CH_IN[2].ANA.TRUE_VALUE := WRITE_INPUT_INT (INP := REAL_TO_INT (iCh2PV * 100.0));
oStsDDT.ANA_CH_IN[3].ANA.TRUE_VALUE := WRITE_INPUT_INT (INP := REAL_TO_INT (iCh3PV * 100.0));
oStsDDT.ANA_CH_IN[4].ANA.TRUE_VALUE := WRITE_INPUT_INT (INP := REAL_TO_INT (iCh4PV * 100.0));
oStsDDT.ANA_CH_IN[5].ANA.TRUE_VALUE := WRITE_INPUT_INT (INP := REAL_TO_INT (iCh5PV * 100.0));
oStsDDT.ANA_CH_IN[6].ANA.TRUE_VALUE := WRITE_INPUT_INT (INP := REAL_TO_INT (iCh6PV * 100.0));
oStsDDT.ANA_CH_IN[7].ANA.TRUE_VALUE := WRITE_INPUT_INT (INP := REAL_TO_INT (iCh7PV * 100.0));
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="SIM_X80DDO1602K" version="0.02" dateTime="dt#2024-02-12-10:19:16">
		<comment>Simulation X80 BMX DDO1602 16 Channel Digital Output Module</comment>
		<attribute name="TypeCodeCheckSumString" value="EB79"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="47D5"></attribute>
		<inputParameters>
			<variables name="iModFlt" typeName="EBOOL">
				<comment>Simulate Module Fault</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oStsDat" typeName="T_U_DIS_STD_OUT_16">
				<comment>DDT of Actual Signals Data Read from DDO Module</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<FBProgram name="sim_X80DDO1602K">
			<STSource>(*=====Mapping Outputs===== *)
(* Toggle Module Fault *)
oStsDAT.MOD_FLT.0 			:= WRITE_INPUT_EBOOL (INP := iModFlt );
oStsDAT.MOD_HEALTH			:= WRITE_INPUT_EBOOL (INP := NOT iModFlt ); (* always healthy *)
</STSource>
		</FBProgram>
	</FBSource>
</STExchangeFile>
