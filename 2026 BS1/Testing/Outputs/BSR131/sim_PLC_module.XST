				<attribute name="IsVariableHidden" value="-1"></attribute>
				<attribute name="ExtractBit" value="9"></attribute>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="SNTP_CLIENT" typeName="BOOL">
				<comment>0: service not operating normally / 1: service operating normally or disabled</comment>
				<attribute name="ExtractBit" value="10"></attribute>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="WEB_SERVER" typeName="BOOL">
				<comment>0: service not operating normally / 1: service operating normally or disabled</comment>
				<attribute name="ExtractBit" value="11"></attribute>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="FIRMWARE_UPGRADE" typeName="BOOL">
				<comment>0: service not operating normally / 1: service operating normally or disabled</comment>
				<attribute name="ExtractBit" value="12"></attribute>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="FTP" typeName="BOOL">
				<comment>0: service not operating normally / 1: service operating normally or disabled</comment>
				<attribute name="ExtractBit" value="13"></attribute>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="FDR_SERVER" typeName="BOOL">
				<comment>0: service not operating normally / 1: service operating normally or disabled</comment>
				<attribute name="ExtractBit" value="14"></attribute>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="EIP_ADAPTER" typeName="BOOL">
				<comment>EIP adapter (server) service 0: service not operating normally / 1: service operating normally or disabled</comment>
				<attribute name="ExtractBit" value="15"></attribute>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="SERVICE_STATUS2" typeName="WORD">
				<comment>One bit for each user-observable feature</comment>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="A_B_IP_ADDRESS_STATUS" typeName="BOOL">
				<comment>IP address A/B status (0 in case of duplicate IP or no IP assigned)</comment>
				<attribute name="ExtractBit" value="0"></attribute>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="LLDP_SERVICE" typeName="BOOL">
				<comment>LLDP service status</comment>
