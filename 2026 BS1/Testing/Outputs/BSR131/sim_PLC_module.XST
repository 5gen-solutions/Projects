<STExchangeFile>
	<fileHeader company="Schneider Automation" product="Control Expert V16.2 - 250430" dateTime="date_and_time#2026-9-8-8:3:2" content="Structured source file" DTDVersion="41"></fileHeader>
	<contentHeader name="BPL131" version="0.0.202" dateTime="date_and_time#2026-7-1-10:24:18"></contentHeader>
	<program>
		<identProgram name="sim_PLC_module" type="section" task="MAST" SectionOrder="4"></identProgram>
		<STSource>(* Head Rack Modules Simulation
CRA Modules Simulation *)

IF sim_SetHealthy THEN

	(* =========== HEAD RACK =========== *)
	(* Set PLC Links Healthy *)
	sim_BPL131PLM0_Mode := 1;(* set ethernet 1 to active (service port) *)
	SIM_BMEP586x4xRIO_0 (iMode := Sim_BPL131PLM0_Mode,
	                     iFlt := Sim_BPL131PLM0_Flt,
	                     iLnkNotAct := Sim_BPL131PLM0_LnkFlt,
	                     oInDatDDT =&gt; BMEP58_ECPU_EXT);
	(* ===== NOC Sim ===== *)
	IF sim_BPL131PLM3_Mode = 1 THEN(* set ethernet 1 to active (service port) *)
	sim_noc0301_0 (iMode 	:= sim_BPL131PLM3_Mode,
               		iFlt 	:= sim_BPL131PLM3_Flt,
               		iComFlt := sim_BPL131PLM3_ComFlt,
               		iLnkNotAct := sim_BPL131PLM3_LnkFlt,
               		oInDatDDT =&gt; PLC_3);		
	END_IF;

	IF sim_BPL131PLM4_Mode = 1 THEN(* set ethernet 1 to active (service port) *)
	sim_noc0301_1 (iMode 	:= sim_BPL131PLM4_Mode,
	               iFlt 	:= sim_BPL131PLM4_Flt,
	               iComFlt 	:= sim_BPL131PLM4_ComFlt,
	               iLnkNotAct := sim_BPL131PLM4_LnkFlt,
	               oInDatDDT =&gt; HMI_4);
	END_IF;

	sim_BPL131PLM5_Mode := 1;(* set ethernet 1 to active (service port) *)
	sim_noc0301_2 (iMode := Sim_BPL131PLM5_Mode,
	               iFlt := Sim_BPL131PLM5_Flt,
		       iComFlt 	:= sim_BPL131PLM5_ComFlt,
	               iLnkNotAct := Sim_BPL131PLM5_LnkFlt,
	               oInDatDDT =&gt; IO_5);


	(* =========== BSR131DX01DIO1PLM0 - DROP 1 =========== *)
	SIM_CRA31210_1 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= sim_BSR131DX01DIO1PLM0_Flt,
                     iComFlt 	:= sim_BSR131DX01DIO1PLM0_ComFlt,
                     iLnkNotAct := sim_BSR131DX01DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D01R00S00); 

	(* =========== BTY1502DX02DIO1PLM0 - DROP 2 =========== *)
	SIM_CRA31210_2 (iMode   := 1,	(* set ethernet 1 to active (service port) *)
	             iFlt 	:= Sim_BTY1502DX02DIO1PLM0_Flt,
	             iComFlt 	:= Sim_BTY1502DX02DIO1PLM0_ComFlt,
	             iLnkNotAct := Sim_BTY1502DX02DIO1PLM0_LnkFlt,
	             oInDatDDT 	=&gt; D02R00S00); 
			
	(* =========== BTY1502DX03DIO1PLM0 - DROP 3 =========== *)
	SIM_CRA31210_3 (iMode   := 1,	(* set ethernet 1 to active (service port) *)
	             iFlt 	:= Sim_BTY1502DX03DIO1PLM0_Flt,
	             iComFlt 	:= Sim_BTY1502DX03DIO1PLM0_ComFlt,
	             iLnkNotAct := Sim_BTY1502DX03DIO1PLM0_LnkFlt,
	             oInDatDDT 	=&gt; D03R00S00); 

	(* =========== BTK2101DX04DIO1PLM0 - DROP 4 =========== *)
	SIM_CRA31210_4 (iMode := 1,	(* set ethernet 1 to active (service port) *)
                     iFlt 	:= sim_BTK2101DX04DIO1PLM0_Flt,
                     iComFlt 	:= sim_BTK2101DX04DIO1PLM0_ComFlt,
                     iLnkNotAct := sim_BTK2101DX04DIO1PLM0_LnkFlt,
                     oInDatDDT 	=&gt; D04R00S00); 
end_if;
</STSource>
	</program>
