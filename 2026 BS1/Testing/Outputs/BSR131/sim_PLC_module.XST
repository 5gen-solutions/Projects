			</variables>
			<variables name="OUT_ERRORS" typeName="UINT">
				<comment>Number of outbound packets that contain errors</comment>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="CONF_SIG" typeName="UDINT">
				<comment>Signature of all files on local module FDR Server</comment>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="DROP_HEALTH" typeName="ARRAY[1..64] OF BOOL">
				<comment>DROP health bits (Drop 1 to 64)</comment>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="RIO_HEALTH" typeName="ARRAY[257..384] OF BOOL">
				<comment>RIO health bits (1 bit per RIO up to 128)</comment>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="LS_HEALTH" typeName="ARRAY[1..3] OF BOOL">
				<comment>Local Slave health bits (Local Slave 1 to 3)</comment>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="DIO_HEALTH" typeName="ARRAY[513..640] OF BOOL">
				<comment>DIO health bits (1 bit per DIO up to 128 DIOs)</comment>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="DEVICE_CNX_HEALTH" typeName="ARRAY[0..7] OF WORD">
				<comment>DIO device health (1 bit per DIO up to 128 DIO)</comment>
				<attribute name="IsVariableHidden" value="-1"></attribute>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="DROP_CTRL" typeName="ARRAY[1..64] OF BOOL">
				<comment>DROP control bits (Drop 1 to 64)</comment>
			</variables>
			<variables name="RIO_CTRL" typeName="ARRAY[257..384] OF BOOL">
				<comment>RIO control bits (1 bit per RIO up to 128)</comment>
			</variables>
			<variables name="DIO_CTRL" typeName="ARRAY[513..640] OF BOOL">
				<comment>DIO control bits (1 bit per DIO up to 128 DIOs)</comment>
			</variables>
			<variables name="SERVICE_CMD" typeName="WORD">
				<comment>bit 0: NTPV4 - command to stop/start the NTP daemon / bit1 -15: reserved for future use</comment>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="NTP_STOP" typeName="BOOL">
				<comment>1: Stop the NTP daemon / 0: Start the NTP daemon</comment>
				<attribute name="ExtractBit" value="0"></attribute>
			</variables>
			<variables name="RED_PRP_DROP_SWAP" typeName="ARRAY[1..64] OF BOOL">
				<comment>PRP drop SWAP Command (in case of redundant CRA in the drop). 1 bit per drop, no test of redundancy.</comment>
			</variables>
			<variables name="RESERVED3" typeName="ARRAY[1..160] OF BYTE">
				<comment>RESERVED3</comment>
				<attribute name="IsVariableHidden" value="-1"></attribute>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
		</structure>
	</DDTSource>
	<FBSource nameOfFBType="sim_noc0301" version="0.52" dateTime="dt#2024-06-14-16:59:25">
		<comment>Simulates healthy and  fault conditions of NOC0301 Module.</comment>
		<attribute name="TypeCodeCheckSumString" value="1AF5"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="BEB7"></attribute>
		<inputParameters>
			<variables name="iMode" typeName="INT">
				<comment>Configuration of Ethernet Link (1=ETH1, 2=ETH2, 3=ET3, default = ETH1)</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iFlt" typeName="EBOOL">
				<comment>Simualte Module Not Running Fault (1= Faulted not running)</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iComFlt" typeName="EBOOL">
				<comment>Simulate Internal Communications Failure from Device DDT (1= Faulted)</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iLnkNotAct" typeName="EBOOL">
				<comment>Simulate Ethernet link active/inactive (0 = Link Active; 1 = Not Link Active)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oInDatDDT" typeName="T_BMENOC0301_2">
				<comment>Input Status DDT data to status DFB of CRA31210 Module.</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<FBProgram name="sim_noc0301">
			<STSource>(* =====Sim NOC0301 Module===== 
Simulates fault conditions of NOC0301 Module.
- Configuration between Which Ethernet Port Connected.
- Module Not running Fault
- Internal Communications Module failure
- Link active inactive status


 -----Inputs----- 
INPUT		TYPE		DESCRIPTION 
iMode		INT		Configuration of Ethernet Link (1 or anyINT Default = ETH1 service port; 
										2   = ETH2 Network Port;
										3   = ETH3 Network Port)
iFlt		EBOOL		Simualte Module Not Running Fault (STSDDT.STATE_RUN = 0)
iComFlt		EBOOL		Simulate Internal Communications Failure from Device DDT
iLnkNotAct	EBOOL		Simulate Ethernet link active/inactive (0 = Link Active; 1 = Not Link Active)

-----Outputs-----
OUTPUT 		TYPE 		DESCRIPTION
oInDatDDT	T_M_CRA_EXT_IN	Input Status DDT data to status DFB of NOC0301 Module.

created: AXY 18/10/2022
*)

(* =====NOC0301 SIMULATION LOGIC===== *)
(* =====Set Ethernet Sts Hty===== *)
oInDatDDT.ETH_STATUS.3 := WRITE_INPUT_EBOOL (INP := TRUE); (* ETH BackPlane port active *)
oInDatDDT.ETH_STATUS.6 := WRITE_INPUT_EBOOL (INP := TRUE); (* IO Set Scanner OK *)
oInDatDDT.ETH_STATUS.8 := WRITE_INPUT_EBOOL (INP := TRUE); (* Network OK *)
oInDatDDT.SERVICE_STATUS.5 := WRITE_INPUT_EBOOL (INP := TRUE); (* MODBUS Scanner OK *)
CASE iMode OF
  2: 

	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := FALSE);
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH2 NETWORK PORT MODE *)
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := FALSE);
  3:
	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := FALSE);
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := FALSE); 	   
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH3 NETWORK PORT MODE *)

ELSE
	(* Simluate Ethernet Link Fault *)
	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* DEFAULT ETH1 PORT MODE *)
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := FALSE); 
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := FALSE);
END_CASE;


(* =====Fault Mapping===== *)
(* COMMS FAULT SIM *)


(* MODULE FAULT (module not running)*)
IF iFlt THEN 
	oInDatDDT.LS_HEALTH[1]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[2]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[3]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[4]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[5]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[6]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[7]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[8]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[9]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[10]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[11]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[12]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[13]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[14]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[15]:=WRITE_INPUT_EBOOL (INP := FALSE);
	oInDatDDT.LS_HEALTH[16]:=WRITE_INPUT_EBOOL (INP := FALSE);

ELSE
	oInDatDDT.LS_HEALTH[1]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[2]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[3]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[4]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[5]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[6]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[7]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[8]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[9]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[10]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[11]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[12]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[13]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[14]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[15]:=WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.LS_HEALTH[16]:=WRITE_INPUT_EBOOL (INP := TRUE);

	oInDatDDT.DIO_HEALTH[0]:=WRITE_INPUT_EBOOL (INP := NOT(iComFlt));
	oInDatDDT.DIO_HEALTH[1]:=WRITE_INPUT_EBOOL (INP := NOT(iComFlt));
