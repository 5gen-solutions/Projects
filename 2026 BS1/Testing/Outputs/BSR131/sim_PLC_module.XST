	<FBSource nameOfFBType="SIM_CRA31210" version="0.37" dateTime="dt#2026-09-01-11:17:19">
		<comment>Simulates X80 32 Channel Digital input module statuses</comment>
		<attribute name="TypeCodeCheckSumString" value="9582"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="165F"></attribute>
		<inputParameters>
			<variables name="iMode" typeName="INT">
				<comment>Configuration of Ethernet Link (1=ETH1, 2=ETH2, 3=ET3, default = ETH1)</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iFlt" typeName="EBOOL">
				<comment>Simualte Module Not Running Fault (1= Faulted not running)</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iComFlt" typeName="EBOOL">
				<comment>Simulate Internal Communications Failure from Device DDT (1= Faulted)</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iLnkNotAct" typeName="EBOOL">
				<comment>Simulate Ethernet link active/inactive (0 = Link Active; 1 = Not Link Active)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oInDatDDT" typeName="T_M_CRA_EXT_IN">
				<comment>Input Status DDT data to status DFB of CRA31210 Module.</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<FBProgram name="sim_CRA31210">
			<STSource>(* =====Sim X80DDI1602 Module===== 
Simulates fault conditions of CRA31210 Module.
- Configuration between Which Ethernet Port Connected.
- Module Not running Fault
- Internal Communications Module failure
- Link active inactive status


 -----Inputs----- 
INPUT		TYPE		DESCRIPTION 
iMode		INT		Configuration of Ethernet Link (1 or anyINT Default = ETH1 service port; 
										2   = ETH2 Network Port;
										3   = ETH3 Network Port)
iFlt		EBOOL		Simualte Module Not Running Fault (STSDDT.STATE_RUN = 0)
iComFlt		EBOOL		Simulate Internal Communications Failure from Device DDT
iLnkNotAct	EBOOL		Simulate Ethernet link active/inactive (0 = Link Active; 1 = Not Link Active)

-----Outputs-----
OUTPUT 		TYPE 		DESCRIPTION
oInDatDDT	T_M_CRA_EXT_IN	Input Status DDT data to status DFB of CRA31210 Module.

created: AXY 18/10/2022
*)

(* =====Set Ethernet Sts Hty===== *)
CASE iMode OF
  2: 
	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := FALSE);
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH2 NETWORK PORT MODE *)
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := FALSE);
  3:
	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := FALSE);
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := FALSE); 	   
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH3 NETWORK PORT MODE *)

ELSE
	(* Simluate Ethernet Link Fault *)
	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* DEFAULT ETH1 PORT MODE *)
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := FALSE); 
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := FALSE);
END_CASE;


(* =====Fault Mapping===== *)
(* COMMS FAULT SIM *)
IF iComFlt THEN 
	oInDatDDt.DROP_COM_HEALTH:= WRITE_INPUT_EBOOL (INP := NOT(iComFlt));
ELSE
	oInDatDDT.DROP_COM_HEALTH:= WRITE_INPUT_EBOOL (INP := TRUE);
END_IF;

(* MODULE FAULT (module not running)*)
IF iFlt THEN 
	oInDatDDT.CRA_STATE.1 := WRITE_INPUT_EBOOL (INP := NOT(iFlt));
	oInDatDDT.CRA_STATE.0 := WRITE_INPUT_EBOOL (INP := NOT(iFlt));
	oInDatDDT.CRA_STATE.2 := WRITE_INPUT_EBOOL (INP := 0);
	oInDatDDT.CRA_STATE.3 := WRITE_INPUT_EBOOL (INP := 0);
	oInDatDDT.CRA_STATE.4 := WRITE_INPUT_EBOOL (INP := 0);
	oInDatDDT.CRA_STATE.5 := WRITE_INPUT_EBOOL (INP := 0);
	oInDatDDT.CRA_STATE.6 := WRITE_INPUT_EBOOL (INP := 0);
	oInDatDDT.CRA_STATE.7 := WRITE_INPUT_EBOOL (INP := 0);
ELSE (* 2#00000011 = STATE_RUN *)
	oInDatDDT.CRA_STATE.0 := WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.CRA_STATE.1 := WRITE_INPUT_EBOOL (INP := TRUE);
	oInDatDDT.CRA_STATE.2 := WRITE_INPUT_EBOOL (INP := 0);
	oInDatDDT.CRA_STATE.3 := WRITE_INPUT_EBOOL (INP := 0);
	oInDatDDT.CRA_STATE.4 := WRITE_INPUT_EBOOL (INP := 0);
	oInDatDDT.CRA_STATE.5 := WRITE_INPUT_EBOOL (INP := 0);
	oInDatDDT.CRA_STATE.6 := WRITE_INPUT_EBOOL (INP := 0);
	oInDatDDT.CRA_STATE.7 := WRITE_INPUT_EBOOL (INP := 0);
END_IF;
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="SIM_BMEP586x4xRIO" version="0.48" dateTime="dt#2026-09-01-11:40:01">
		<attribute name="TypeCodeCheckSumString" value="4836"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="A1D6"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="iMode" typeName="INT">
				<comment>Configuration of Ethernet Link, default = ETH1 (1=ETH1, 2=ETH2, 3=ET3, 4 = ETH2 ETH3)</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iFlt" typeName="EBOOL">
				<comment>Simualte Module Not Running Fault (1= Faulted not running)</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iRdnFlt" typeName="EBOOL">
				<comment>Simulate Internal Communications Failure from Device DDT (1= Faulted)</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iLnkNotAct" typeName="EBOOL">
				<comment>Simulate Ethernet link active/inactive (0 = Link Active; 1 = Not Link Active)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oInDatDDT" typeName="T_BMEP58_ECPU_EXT2">
				<comment>Input Status DDT data to status DFB of CRA31210 Module.</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<FBProgram name="sim_BMEP586x4xRIO">
			<STSource>(* =====Sim X80DDI1602 Module===== 
Simulates fault conditions of CRA31210 Module.
- Configuration between Which Ethernet Port Connected.
- Module Not running Fault
- Internal Communications Module failure
- Link active inactive status


 -----Inputs----- 
INPUT		TYPE		DESCRIPTION 
iMode		INT		Configuration of Ethernet Link (1 or anyINT Default = ETH1 service port; 
										2   = ETH2 Network Port;
										3   = ETH3 Network Port
										4   = ETH2 ETH3 Network Ports)
iFlt		EBOOL		Simualte Module Not Running Fault (STSDDT.STATE_RUN = 0)
iComFlt		EBOOL		Simulate Internal Communications Failure from Device DDT
iLnkNotAct	EBOOL		Simulate Ethernet link active/inactive (0 = Link Active; 1 = Not Link Active)

-----Outputs-----
OUTPUT 		TYPE 		DESCRIPTION
oInDatDDT	T_M_CRA_EXT_IN	Input Status DDT data to status DFB of CRA31210 Module.

created: AXY 18/10/2022
updated: AXY 12/05/2023
*)

(* =====Set Ethernet Sts Hty===== *)
CASE iMode OF
  2: 
	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := FALSE);
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH2 NETWORK PORT MODE *)
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := FALSE);
  3:
	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := FALSE);
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := FALSE); 	   
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH3 NETWORK PORT MODE *)

  4:
  	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := FALSE);
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH2 NETWORK PORT MODE *)
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH3 NETWORK PORT MODE *)

ELSE
	(* Simluate Ethernet Link Fault *)
	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* DEFAULT ETH1 PORT MODE *)
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := FALSE); 
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := FALSE);
END_CASE;

(* =====Default Hty States===== *)
oInDatDDT.ETH_STATUS.8 := WRITE_INPUT_EBOOL (INP := TRUE); (* NetDiagOK *)
oInDatDDT.SERVICE_STATUS2.0 := WRITE_INPUT_EBOOL (INP:= TRUE); (* RIOAdrOK *)
oInDatDDT.SERVICE_STATUS.14 := WRITE_INPUT_EBOOL (INP:= TRUE); (* ServFDR *)
oInDatDDT.MAIN_IP_ADDRESS_STATUS := WRITE_INPUT_EBOOL (INP:= TRUE); (* Duplicate Ip *)

(* =====Fault Mapping===== *)
(* Redundancy Error Sim *)
oInDatDDT.ETH_STATUS.5 := WRITE_INPUT_EBOOL (INP := NOT( iRdnFlt)); (* RdnOK *)

(* ScnOK *)
oInDatDDT.ETH_STATUS.6 := WRITE_INPUT_EBOOL (INP := Not( iLnkNotAct)); (* ScnOK *)

(* Network Fault *)
oInDatDDT.ETH_BKP_FAILURE := WRITE_INPUT_EBOOL (INP := NOT(iFlt)); (* BK plane fault *)
</STSource>
		</FBProgram>
	</FBSource>
	<DDTSource DDTName="T_BMEP58_ECPU_EXT2" version="4.00" dateTime="dt#2021-02-24-10:00:00">
		<comment>Enhanced Device DDT for embedded M580 DTM (with standalone PLC)</comment>
		<attribute name="IsTypeLocked" value="TRUE"></attribute>
		<attribute name="IsDeviceDDT" value="TRUE"></attribute>
		<attribute name="DeviceDDTKind" value="2#0000_0000"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="76DD"></attribute>
		<attribute name="IsHSBYExchange" value="FALSE"></attribute>
		<attribute name="IsTypeHiddenButExported" value="TRUE"></attribute>
		<structure>
			<variables name="CRA_CNX_HEALTH" typeName="ARRAY[1..128] OF BYTE">
				<comment>CRA health (Drop 1 to 128)</comment>
