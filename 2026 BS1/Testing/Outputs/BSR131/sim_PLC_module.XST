				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="RESERVED2" typeName="WORD">
				<comment>Reserved</comment>
				<attribute name="IsVariableHidden" value="-1"></attribute>
				<attribute name="RequestAccessRight" value="1"></attribute>
				<attribute name="InstancesProgramAccessRight" value="1"></attribute>
			</variables>
			<variables name="IN_PACKETS" typeName="UINT">
				<comment>Number of packets received on interface</comment>
