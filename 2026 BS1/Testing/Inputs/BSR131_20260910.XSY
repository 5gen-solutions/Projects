			</variables>
			<variables name="DATA_OUT_7" typeName="WORD">
				<comment>Configurable Parameter Output 7</comment>
			</variables>
			<variables name="DATA_OUT_8" typeName="WORD">
				<comment>Configurable Parameter Output 8</comment>
			</variables>
			<variables name="DATA_OUT_9" typeName="WORD">
