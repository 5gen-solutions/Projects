	<FBSource nameOfFBType="StatPls" version="1.11" dateTime="dt#2024-11-07-13:02:09">
		<comment>Totaliser Pulse Generation DFB</comment>
		<attribute name="TypeCodeCheckSumString" value="E0FD"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="A798"></attribute>
		<inputParameters>
			<variables name="iSetHr" typeName="INT">
				<comment>Set Pulse Hour for Day/Week/Month Pulse (0-23Hr) Default 0</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iSetMin" typeName="INT">
				<comment>Set Pulse Minute for Day/Week/Month Pulse (0-60min) Default 0</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iSetDOW" typeName="INT">
				<comment>Set Pulse Day of Week for Weekly Pulse (1-7day) Default 1</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="iSetDay" typeName="INT">
				<comment>Set Pulse Day of Month for Monthly Pulse (1-31day) Default 1</comment>
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="iSetShfHr" typeName="INT">
				<comment>Set Shift Hour for Shift Pulse (0-23Hr) Default 0</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iSetShfMin" typeName="INT">
				<comment>Set Shift Minute for Shift Pulse (0-60min) Default 0</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oStatPls" typeName="TotaliserStatPlsDDT">
				<comment>Change of Statistic Pulse</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="DAY_R_TRIG" typeName="R_TRIG">
				<comment>Day Pulse Trigger</comment>
			</variables>
			<variables name="WEEK_R_TRIG" typeName="R_TRIG">
				<comment>Week Pulse Trigger</comment>
			</variables>
			<variables name="MONTH_R_TRIG" typeName="R_TRIG">
				<comment>Month Pulse Trigger</comment>
			</variables>
			<variables name="LocTmArr" typeName="ARRAY[0..3] OF INT">
				<comment>Local Time Array</comment>
			</variables>
			<variables name="LocTm" typeName="ClockDDT">
				<comment>Local Time DDT</comment>
			</variables>
			<variables name="SHIFT_R_TRIG" typeName="R_TRIG">
				<comment>Shift Pulse Trigger</comment>
			</variables>
			<variables name="ShiftDuration" typeName="INT">
				<comment>Shift Duration (Hours)</comment>
			</variables>
			<variables name="MinuteEqual" typeName="EBOOL">
				<comment>Minute Equal to Minute Setpoint for Day/Week/Month Pulse</comment>
			</variables>
			<variables name="HourEqual" typeName="EBOOL">
				<comment>Hour Equal to Hour Setpoint for Day/Week/Month Pulse</comment>
			</variables>
			<variables name="DayOfWeek" typeName="INT">
				<comment>Day of Week for Weekly Pulse (1-7day)</comment>
			</variables>
			<variables name="DayOfMonth" typeName="INT">
				<comment>Day of Month for Monthly Pulse (1-31 day)</comment>
			</variables>
			<variables name="Shift2Hr" typeName="INT">
				<comment>Hour for the Second Shift Pulse (24h time format)</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="StatPls">
			<comment>Totaliser Pulse Generation</comment>
			<FBDSource nbRows="57" nbColumns="15">
				<networkFBD>
					<FFBBlock instanceName=".8" typeName="BCD_TO_INT" additionnalPinNumber="0" enEnO="false" width="8" height="5">
						<objPosition posX="73" posY="81"></objPosition>
						<descriptionFFB execAfter="">
							<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
							<inputVariable invertedPin="false" formalParameter="IN" effectiveParameter="%SW49"></inputVariable>
							<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
							<outputVariable invertedPin="false" formalParameter="OUT" effectiveParameter="LocTm.DOW"></outputVariable>
						</descriptionFFB>
					</FFBBlock>
					<FFBBlock instanceName="DAY_R_TRIG" typeName="R_TRIG" additionnalPinNumber="0" enEnO="false" width="7" height="5">
						<objPosition posX="64" posY="209"></objPosition>
						<descriptionFFB execAfter="">
							<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
							<inputVariable invertedPin="false" formalParameter="CLK"></inputVariable>
							<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
							<outputVariable invertedPin="false" formalParameter="Q" effectiveParameter="oStatPls.Day"></outputVariable>
