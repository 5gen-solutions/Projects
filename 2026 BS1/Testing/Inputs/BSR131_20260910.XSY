					<textBox width="40" height="9">RdntCom Logic 
******************
The following logic controls the primary and secondary communications channels, communicatons faults
    <objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="32" height="5">Map primary data if healthy

Only map data on heartbeat change when Hold selected and heartbeat is enabled
    <objPosition posX="98" posY="130"></objPosition>
					</textBox>
					<textBox width="70" height="3">Primary Communications Channel
===========================
    <objPosition posX="0" posY="31"></objPosition>
					</textBox>
					<textBox width="30" height="6">Primary communications is faulted if the communications status is unheatlhy or the communications cards is not enabled.
    <objPosition posX="80" posY="80"></objPosition>
					</textBox>
					<textBox width="20" height="4">Primary communications is never disabled from 
communicating
    <objPosition posX="80" posY="40"></objPosition>
					</textBox>
					<textBox width="71" height="3">Secondary Communications Channel
==============================
    <objPosition posX="0" posY="69"></objPosition>
					</textBox>
					<textBox width="22" height="5">The communications data is ok provided either primary or secondary communications are healthy, and there is no heartbeat fault.
    <objPosition posX="80" posY="107"></objPosition>
					</textBox>
					<textBox width="20" height="4">If primary is faulted, the secondary communications disable output clears
    <objPosition posX="80" posY="73"></objPosition>
					</textBox>
					<textBox width="30" height="6">Map second data if healthy and primary unhealthy.

Only map data on heartbeat change when Hold selected and heartbeat is enabled
    <objPosition posX="100" posY="150"></objPosition>
					</textBox>
					<textBox width="19" height="5">Setup
===========================
Configure global values
    <objPosition posX="0" posY="11"></objPosition>
					</textBox>
					<textBox width="70" height="3">Data Health Status
==============================
    <objPosition posX="0" posY="101"></objPosition>
					</textBox>
					<textBox width="70" height="3">If Selected, Clear Output Data on Fault
========================================
    <objPosition posX="0" posY="169"></objPosition>
					</textBox>
					<textBox width="31" height="6">Primary communications is faulted if the communications status is unheatlhy or the communications cards is not enabled.
    <objPosition posX="80" posY="54"></objPosition>
					</textBox>
					<textBox width="70" height="3">Map Healthy Channel Communications Data to Output Data
===============================================
    <objPosition posX="0" posY="124"></objPosition>
					</textBox>
					<textBox width="34" height="4">Set all output data to zero if heartbeat timeout has failed or if both primary and secondary communictions channels are unhealthy
    <objPosition posX="63" posY="176"></objPosition>
					</textBox>
				</networkFBD>
			</FBDSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="Seasons" version="0.01" dateTime="dt#2021-04-09-11:20:50">
		<attribute name="TypeCodeCheckSumString" value="A866"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="FE2F"></attribute>
		<inputParameters>
			<variables name="Month" typeName="INT">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="Summer" typeName="BOOL">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Spring" typeName="BOOL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="Autumn" typeName="BOOL">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="Winter" typeName="BOOL">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
		</outputParameters>
		<FBProgram name="Code">
			<STSource>CASE MONTH OF
1:
Summer:=1;
Winter:=0;
Autumn:=0;
Spring:=0;
2:
Summer:=1;
Winter:=0;
Autumn:=0;
Spring:=0;

3:
Summer:=0;
Winter:=0;
Autumn:=1;
Spring:=0;
4:
Summer:=0;
Winter:=0;
Autumn:=1;
Spring:=0;
5:
Summer:=0;
Winter:=0;
Autumn:=1;
Spring:=0;
6:
Summer:=0;
Winter:=1;
Autumn:=0;
Spring:=0;
7:
Summer:=0;
Winter:=1;
Autumn:=0;
Spring:=0;
8:
Summer:=0;
Winter:=1;
Autumn:=0;
Spring:=0;
9:
Summer:=0;
Winter:=0;
Autumn:=0;
Spring:=1;
10:
Summer:=0;
Winter:=0;
Autumn:=0;
Spring:=1;
11:
Summer:=0;
Winter:=0;
Autumn:=0;
Spring:=1;
12:
Summer:=1;
Winter:=0;
Autumn:=0;
Spring:=0;
  ELSE
Summer:=0;
Winter:=1;
Autumn:=0;
Spring:=0;

END_CASE;
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="SIM_ACS880" version="0.26" dateTime="dt#2020-03-27-14:44:20">
		<comment>ABB ACS880 VSD Drive Interface Simulation</comment>
		<attribute name="TypeCodeCheckSumString" value="1E58"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="991F"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="iOutDatDDT" typeName="ACS880RawOutDDT">
				<comment>DDT of Actual Signal Data to be Written to Unit</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iDrvCtl" typeName="INT">
				<comment>Drive Control Type (0=FullComms; 1=Relay w/ CommSpd; 2=FullHardwire)</comment>
				<attribute name="PositionPin" value="11"></attribute>
			</variables>
			<variables name="iSR01" typeName="EBOOL">
				<comment>Hardwired Run Forward Start Relay</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="iSR02" typeName="EBOOL">
				<comment>Hardwired Run Reverse Start Relay</comment>
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="iNoRmp" typeName="EBOOL">
				<comment>Disable VSD Speed Ramping</comment>
				<attribute name="PositionPin" value="13"></attribute>
			</variables>
			<variables name="iRst" typeName="EBOOL">
				<comment>Drive Reset Signal (Set to 1 for auto reset) (Not Required for Comms control)</comment>
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
			<variables name="iSpdSP" typeName="REAL">
				<comment>Hardwired Speed Setpoint (%)</comment>
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
			<variables name="iCB01" typeName="EBOOL">
				<comment>Main 415VAC Circuit Breaker</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iIMax" typeName="REAL">
				<comment>Maximum Current (A) (Used for simulating analogue values)</comment>
				<attribute name="PositionPin" value="12"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="ioSIM" typeName="SIM_ACS880DDT">
				<comment>Simulation Control DDT</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="oInDatDDT" typeName="ACS880RawInDDT">
				<comment>DDT of Actual Signals Data Read from Unit</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="oSpdFB" typeName="REAL">
				<comment>Speed Feedback (Absolute Value)</comment>
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="oIAvg" typeName="REAL">
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
			<variables name="oTrq" typeName="REAL">
				<attribute name="PositionPin" value="10"></attribute>
			</variables>
			<variables name="oFrq" typeName="REAL">
				<attribute name="PositionPin" value="11"></attribute>
			</variables>
			<variables name="oPwr" typeName="REAL">
				<attribute name="PositionPin" value="12"></attribute>
			</variables>
			<variables name="oTmp" typeName="REAL">
				<attribute name="PositionPin" value="13"></attribute>
			</variables>
			<variables name="oFwdFB" typeName="EBOOL">
				<comment>Running Forward Feedback</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="oRevFB" typeName="EBOOL">
				<comment>Running Reverse Feedback</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="SW" typeName="WORD">
				<comment>ACS880 Status Word</comment>
			</variables>
			<variables name="DI" typeName="WORD">
				<comment>ACS880 Digital Inputs Word</comment>
			</variables>
			<variables name="BS" typeName="WORD">
				<comment>ACS880 Brake Status Word</comment>
			</variables>
			<variables name="SS" typeName="WORD">
				<comment>ACS880 Speed Status Word</comment>
			</variables>
			<variables name="CW" typeName="WORD">
				<comment>ACS880 Control Word</comment>
			</variables>
			<variables name="State" typeName="DINT">
				<comment>Simulation State</comment>
			</variables>
			<variables name="SpdRef" typeName="REAL"></variables>
			<variables name="Fault" typeName="EBOOL"></variables>
			<variables name="ResetLst" typeName="EBOOL">
				<comment>Reset Last Scan</comment>
			</variables>
			<variables name="RAMP_0" typeName="RAMP"></variables>
			<variables name="RAMP_0_PARA" typeName="Para_RAMP"></variables>
			<variables name="SpdDes" typeName="REAL">
				<comment>Pre Ramp Sim Speed</comment>
			</variables>
			<variables name="SpdFBPc" typeName="REAL"></variables>
			<variables name="VAC" typeName="REAL"></variables>
			<variables name="PF" typeName="REAL"></variables>
			<variables name="PMax" typeName="REAL"></variables>
			<variables name="CtlFB" typeName="EBOOL"></variables>
			<variables name="CtlFBHW" typeName="EBOOL"></variables>
			<variables name="CtlHW" typeName="EBOOL"></variables>
			<variables name="R_TRIG_0" typeName="R_TRIG"></variables>
			<variables name="F_TRIG_0" typeName="F_TRIG"></variables>
		</privateLocalVariables>
		<FBProgram name="SIM_ACS880">
			<STSource>(* ABB ACS880 VSD Simulation Block

Revision History:
2020/03/20 09:46 - NJA - Initial Creation
*)

(* Determine the type of drive control *)
CtlFB := iDrvCtl = 0;
CtlFBHW := iDrvCtl = 1;
CtlHW := iDrvCtl = 2;



(* ioSIM.Loc status *)
SW.9 := NOT ioSIM.Loc;

(* STO feedback *)
SW.13 := ioSIM.STOFlt;

(* Read control word *)
CW := iOutDatDDT.CW;
SpdRef := W_INT_REAL(iOutDatDDT.Speed_Ref) / 200.0;  (* Speed ref as % *)

(* Fault / OFF2 / OFF3 active states (transition from any state). OFF3 not used. *)
IF State &lt;&gt; 13 THEN
	IF Fault OR SW.13 THEN 
		State := 10;
	ELSIF NOT CW.1 THEN
		State := 11;  (* coast stop *)
	(* ELSIF NOT CW.2 THEN
		State := 12; *)
	ELSIF NOT iCB01 THEN
		State := 0;
	END_IF;
END_IF;

(* OFF1 ramp stop state transition *)
IF NOT (State = 1 OR State = 2 OR State &gt;= 10) THEN
	IF NOT CW.0 THEN
		State := 9;
	END_IF;
END_IF;

IF ioSIM.Loc THEN
	State := 14; (* local state *)
ELSE
	SW.9 := 1;  (* remote status *)
END_IF;

(*
VSD States
From state diagram ABB ACS880 Firmware Manual
*)

CASE State OF

0: 	(* MAINS OFF *)
	SW := 0;  
	SS := 0;
	IF iCB01 THEN	
		State := 1;
	END_IF;


1:  (* NOT READY TO SWITCH ON *)
	SW.0 := 0;
	IF CtlFB OR CtlFBHW THEN
		IF NOT CW.0 AND CW.1 AND CW.2 AND CW.10 THEN   (* CW=xxxx x1xx xxxx x110  *)
			State := 2;  
		END_IF;
	ELSIF  CtlHW THEN
		State := 2;
	END_IF;


2:  (* READY TO SWITCH ON *)
	SW.0 := 1;
	IF CtlFB OR CtlFBHW THEN
		IF CW.0 AND CW.1 AND CW.2 AND CW.10 THEN   (* CW=xxxx x1xx xxxx x111  *)
			State := 3;
		END_IF;
	ELSIF CtlHW THEN
		State := 3;
	END_IF;


3:  (* READY TO OPERATE *)
	SW.1 := 1;
	IF CtlFB THEN
		IF CW.0 AND CW.1 AND CW.2 AND CW.3 AND CW.10 THEN   (* CW=xxxx x1xx xxxx 1111  *)
			State := 4;  
		END_IF;
	ELSIF CtlFBHW THEN
		IF CW.0 AND CW.1 AND CW.2 AND (iSR01 OR iSR02) AND CW.10 THEN   (* CW=xxxx x1xx xxxx 1111  *)
			State := 7;  
		END_IF;
	ELSIF CtlHW THEN
		IF (iSR01 OR iSR02) THEN
			State := 7;
		END_IF;
	END_IF;


4:  (* OPERATION ENABLED *)
	SW.2 := 1;
	
	IF CtlFB THEN
		IF CW.0 AND CW.1 AND CW.2 AND CW.3 AND CW.4 AND CW.10 THEN   (* CW=xxxx x1xx xxx1 1111  *)
			State := 5;
		ELSIF NOT CW.3 THEN 
			State := 6; 
		END_IF;
	ELSIF CtlFBHW THEN
		IF CW.0 AND CW.1 AND CW.2 AND (iSR01 OR iSR02) AND CW.10 THEN   (* CW=xxxx x1xx xxx1 1111  *)
			State := 7;
		END_IF;
	ELSIF CtlHW THEN
		IF (iSR01 OR iSR02) THEN
			State := 7;
		ELSE
			State := 6;
		END_IF;
	END_IF;


5:  (* RFG: OUTPUT ENABLED *)

	IF CtlFB THEN
		IF CW.0 AND CW.1 AND CW.2 AND CW.3 AND CW.4 AND CW.5 AND CW.10 THEN   (* CW=xxxx x1xx xx11 1111  *)
			State := 7;
		ELSIF NOT CW.3 THEN  
			State := 6;
		ELSIF NOT CW.4 THEN
			State := 4;
		END_IF;
	ELSIF CtlFBHW THEN
		IF CW.0 AND CW.1 AND CW.2 AND (iSR01 OR iSR02) AND CW.10 THEN   (* CW=xxxx x1xx xx11 1111  *)
			State := 7;
		ELSIF NOT (iSR01 OR iSR02) THEN  
			State := 6;
		END_IF;
	ELSIF CtlHW THEN
		IF (iSR01 OR iSR02) THEN
			State := 7;
		ELSE
			State := 6;
		END_IF;
	END_IF;


6:  (* OPERATION INHIBITED *)
	SW.2 := 0;
	State := 3;


7:  (* RFG: ACCELERATOR ENABLED *)
	
	IF CtlFB THEN
		IF CW.0 AND CW.1 AND CW.2 AND CW.3 AND CW.4 AND CW.5 AND CW.6 AND CW.10 AND (oSpdFB = SpdRef) THEN   (* CW=xxxx x1xx xx11 1111  *)
			State := 8;
		ELSIF NOT CW.3 THEN
			State := 6;
		ELSIF NOT CW.4 THEN
			State := 4;
		ELSIF NOT CW.5 THEN
			State := 5;
		END_IF;
	ELSIF CtlFBHW THEN
		IF CW.0 AND CW.1 AND CW.2 AND (iSR01 OR iSR02) AND CW.10 AND (oSpdFB = SpdRef) THEN   (* CW=xxxx x1xx xx11 1111  *)
			State := 8;
		ELSIF NOT (iSR01 OR iSR02) THEN
			State := 6;
		END_IF;
	ELSIF CtlHW THEN
		IF (iSR01 OR iSR02) THEN
			State := 7;
		ELSE
			State := 6;
		END_IF;
	END_IF;


8:  (* OPERATION *)
	(*SW.8 := 1; *)
	
	IF CtlFB THEN
		IF NOT CW.6 THEN   
			State := 7;
		ELSIF NOT CW.3 THEN
			State := 6;
		ELSIF NOT CW.4 THEN
			State := 4;
		ELSIF NOT CW.5 THEN
			State := 5;
		END_IF;
	ELSIF CtlFBHW OR CtlHW THEN
		IF NOT (iSR01 OR iSR02) THEN
			State := 6;
		END_IF;
	END_IF;


9:  (* OFF1 ACTIVE *)
	SW.1 := 0;
	IF oSpdFB = 0.0 THEN
		State := 1;
	END_IF;


10: (* FAULT *)
	SW.3 := 1;
	
	IF NOT Fault AND (iRst OR (CW.7 AND NOT ResetLst)) THEN
		SW.3 := 0; (* reset tripped status *)
		State := 13;
	END_IF;


11: (* OFF2 ACTIVE *)
	SW.4 := 0;
	IF CW.1 THEN
		SW.4 := 1;
		State := 13;
	END_IF;


12: (* OFF3 Active *)
	SW.5 := 0;
	IF oSpdFB = 0.0 THEN 
		State := 13; 
	END_IF;


13: (*SWITCH-ON INHIBITED *)
	SW.6 := 1;

	IF CtlFB OR CtlFBHW THEN
		IF NOT CW.0 AND CW.1 AND CW.2 THEN
			SW.6 := 0;  (* reset inhibited status *)
			State := 1;
		END_IF;
	ELSIF CtlHW THEN
		SW.6 := 0;  (* reset inhibited status *)
		State := 1;
	END_IF;


14: (* ioSIM.Loc *)
	SW := 16#33;
	IF NOT ioSIM.Loc THEN
		State := 1;
	END_IF;


END_CASE;



(* =============== Speed Calcs =============== *)

(* Actual speed feedback *)
IF NOT ioSIM.SpdOvr THEN
	IF State = 7 OR State = 8 THEN
		IF CtlFB OR CtlFBHW THEN
			IF iSR01 THEN
				SpdDes := SpdRef;
			ELSIF iSR02 THEN
				SpdDes := -SpdRef;
			END_IF;
		ELSIF CtlHW THEN
			IF iSR01 THEN
				SpdDes := iSpdSP;
			ELSIF iSR02 THEN
				SpdDes := -iSpdSP;
			END_IF;
		END_IF;
		IF oSpdFB &gt; (0.9 * SpdDes) AND oSpdFB &lt; (1.1 * SpdDes) THEN  (* At speed if speed within 10% of reference *)
			SW.8 := 1;
		ELSE
			SW.8 := 0;
		END_IF;
	ELSE
		SpdDes := 0.0;
		SW.8 := 0;
	END_IF;
ELSE
	SpdDes := ioSIM.SpdSP;
END_IF;

(* Ramp the speed feedback *)
RAMP_0_PARA.inc_rate := 10.0;
IF State = 9 THEN
	RAMP_0_PARA.dec_rate := 15.0;  (* normal stop *)
ELSE
	RAMP_0_PARA.dec_rate := 25.0;  (* emergency stop *)
END_IF;
(* No ramp for failed to start/stop alarm testing *)
IF iNoRmp OR ioSIM.SpdOvr THEN
	RAMP_0_PARA.inc_rate := 0.0;
	RAMP_0_PARA.dec_rate := 0.0;
END_IF;
RAMP_0 (RSP := SpdDes,
        PARA := RAMP_0_PARA,
        TR_I := 0.0,
        TR_S := 0,
        SP =&gt; oSpdFB);
SpdFBPc := oSpdFB / 100.0;

(* Write Speed feedback back to sim value for bumpless transfer *)
IF NOT ioSIM.SpdOvr THEN
	ioSIM.SpdSP := oSpdFB;
END_IF;



(* =============== Calculate Misc Values =============== *)

(* Actuals current/torque/power feedback *)
IF State = 7 THEN
	oIAvg := iIMax * SpdFBPc;  (* max current on startup *)
	oTrq := 100.0;  (* max torque on startup *)
ELSE
	oIAvg := iIMax * 0.5 * SpdFBPc;  (* 50% current load on running *)
	IF oSpdFB &gt; 0.0 THEN
		oTrq := 20.0;  (* 20% torque on running *)
	ELSE
		oTrq := 0.0;
	END_IF;
END_IF;

(* Actuals frequency feedback *)
oFrq := 50.0 * SpdFBPc;

(* Actuals torque power *)
VAC := 415.0;
PF := 0.97;
PMax := sqrt(3.0) * VAC * iIMax * PF;
oPwr := sqrt(3.0) * VAC * oIAvg * PF / PMax * 100.0;

(* Actuals temperature *)
oTmp := 25.0;

IF oSpdFB &gt; 0.02 THEN  (* speed &gt; zero speed limit 30rpm *)
	SS.1 := 1;
	SS.2 := 0;
	oFwdFB := 1;
	oRevFB := 0;
ELSIF oSpdFB &lt; -0.02 THEN  (* speed &gt; zero speed limit 30rpm *)
	SS.1 := 0;
	SS.2 := 1;
	oFwdFB := 0;
	oRevFB := 1;
ELSE
	SS.1 := 0;
	SS.2 := 0;
	oFwdFB := 0;
	oRevFB := 0;
END_IF;


(* Digital inputs *)
DI.0 := iSR01;
DI.1 := iSR02;
DI.2 := SW.1;
DI.15 := NOT ioSIM.ILFlt;



(* =============== Map Out Outputs =============== *)

(*Status word *)
oInDatDDT.SW := SW;

(*Speed Actual *)
oInDatDDT.Act_Speed := R_INT_WORD(oSpdFB * 200.0);

(*Speed Status *)
oInDatDDT.DATA_IN_1 := SS;

(*Digital Inputs *)
oInDatDDT.DATA_IN_2 := DI;

(*Brake Status (not simulated) *)
BS.0 := 0;
oInDatDDT.DATA_IN_3 := BS;

(* Actuals *)
oInDatDDT.DATA_IN_4 := R_INT_WORD(oIAvg);
oInDatDDT.Act_Torque := R_INT_WORD(oTrq * 100.0);
oInDatDDT.DATA_IN_6 := R_INT_WORD(oFrq * 400.0);
oInDatDDT.DATA_IN_7 := R_INT_WORD(oPwr * 10.0);
oInDatDDT.DATA_IN_8 := R_INT_WORD(oTmp);

(* Fault Number (not simulated) *)
IF Fault THEN
	oInDatDDT.DATA_IN_9 := 99;
ELSE
	oInDatDDT.DATA_IN_9 := 0;
END_IF;

(* Future *)
oInDatDDT.DATA_IN_10 := 0;


(* storage bit for reset transition *)
ResetLst := CW.7;





(*
	IF CtlFB THEN
	
	ELSIF CtlFBHW THEN

	ELSIF CtlHW THEN

	END_IF;
*)
</STSource>
		</FBProgram>
	</FBSource>
	<DDTSource DDTName="SIM_ACS880DDT" version="0.04" dateTime="dt#2020-03-27-13:50:40">
		<attribute name="TypeSignatureCheckSumString" value="8219"></attribute>
		<structure>
			<variables name="Run" typeName="INT">
				<comment>Run Mode (0=Sim; 1=Stp; 2=Fwd; 3= Rev)</comment>
			</variables>
			<variables name="SpdOvr" typeName="BOOL">
				<comment>Speed Override Active</comment>
			</variables>
			<variables name="SpdSP" typeName="REAL">
				<comment>Speed (Bumpless Between Speed Override)</comment>
			</variables>
			<variables name="STOFlt" typeName="BOOL">
				<comment>STO (Safe Torque Off) Fault</comment>
			</variables>
			<variables name="Loc" typeName="BOOL">
				<comment>Mode Local</comment>
			</variables>
			<variables name="ILFlt" typeName="BOOL">
				<comment>DI ILOK Fault</comment>
			</variables>
		</structure>
	</DDTSource>
	<FBSource nameOfFBType="sim_AHI_Scale" version="0.21" dateTime="dt#2024-05-20-14:29:47">
		<attribute name="TypeCodeCheckSumString" value="2381"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="55CD"></attribute>
		<inputParameters>
			<variables name="iMax" typeName="REAL">
				<comment>Max PV Eng Out Value </comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iMin" typeName="REAL">
				<comment>Min PV Eng Out</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iRand_LL" typeName="REAL">
				<comment>Lower Random Number Limit</comment>
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="iRand_UL" typeName="REAL">
				<comment>Upper Random Number imit</comment>
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
			<variables name="iFrzVal" typeName="EBOOL">
				<comment>Remove Random Number Modifier</comment>
				<attribute name="PositionPin" value="10"></attribute>
			</variables>
			<variables name="iEngMin" typeName="REAL">
				<comment>Eng Min for Scaling (=0)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iEngMax" typeName="REAL">
				<comment>Eng Max for Scaling to raw (=10000)</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="iOvrPV" typeName="REAL">
				<comment>Override PV number if OvrPV not equal to 0</comment>
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="ioPV" typeName="REAL">
				<comment>input PV from simulation (eng units)</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="oPVEng" typeName="REAL">
				<comment>Simulated PV Eng Units</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="oPVPer" typeName="REAL">
				<comment>Simulated Raw value 0-100% of scale</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="Simulation_Random_Number_0" typeName="Simulation_Random_Number"></variables>
			<variables name="Rand_Num" typeName="REAL">
				<comment>Random Number</comment>
			</variables>
			<variables name="RawMin" typeName="REAL">
				<comment>Raw Min for AI scaling</comment>
			</variables>
			<variables name="RawMax" typeName="REAL">
				<comment>Raw Max for AI Scaling</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="sim_AHI_Scale">
			<STSource>(*------------------------------------------------------------------------------

ANALOG SCALING SIMULATION

ioPV		Process value in Engineering Units (ms-1, L/s, etc..)

iMin		Process value minimum
iMax		Process value maximum
iEngMax		Engineering Value Maximum
iEngMin		Engineer Value Minimum
iOvrPV		Override Process Value when iOvrPV &lt;&gt; 0 
iRand_xL	Upper and lower random number limits - 0 = no random number

23/11/2023 	AXY -  Sim analog scaling block; derived from PROC_Linear DFB
------------------------------------------------------------------------------*)

(* always calculate random number for use *)
Simulation_Random_Number_0 (LowerLimit := iRand_LL,
                            UpperLimit := iRand_UL,
                            RandomNumber =&gt; Rand_Num);
(* Override Sim Process Value *)
IF iOvrPV &lt;&gt; 0.0 THEN
	ioPV := LIMIT (
		MN := iMin,
		IN := iOvrPV,
		MX := iMax
		);
END_IF;

(* Add + Enable/Disable Random Number *)
IF iFrzVal THEN
	oPVEng := ioPV;
ELSE
	oPVEng := ioPV + Rand_Num;
END_IF;

(* calculate raw value for AI mapping block AS A % *)
RawMax := 100.0;
RawMin := 0.0;
oPVPer := RawMin + (oPVEng - iEngMin)*(RawMax - RawMin)/(iEngMax - iEngMin);
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="SIM_BMEP586x4xRIO" version="0.48" dateTime="dt#2026-09-01-11:40:01">
		<attribute name="TypeCodeCheckSumString" value="4836"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="A1D6"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="iMode" typeName="INT">
				<comment>Configuration of Ethernet Link, default = ETH1 (1=ETH1, 2=ETH2, 3=ET3, 4 = ETH2 ETH3)</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iFlt" typeName="EBOOL">
				<comment>Simualte Module Not Running Fault (1= Faulted not running)</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iRdnFlt" typeName="EBOOL">
				<comment>Simulate Internal Communications Failure from Device DDT (1= Faulted)</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iLnkNotAct" typeName="EBOOL">
				<comment>Simulate Ethernet link active/inactive (0 = Link Active; 1 = Not Link Active)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oInDatDDT" typeName="T_BMEP58_ECPU_EXT2">
				<comment>Input Status DDT data to status DFB of CRA31210 Module.</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<FBProgram name="sim_BMEP586x4xRIO">
			<STSource>(* =====Sim X80DDI1602 Module===== 
Simulates fault conditions of CRA31210 Module.
- Configuration between Which Ethernet Port Connected.
- Module Not running Fault
- Internal Communications Module failure
- Link active inactive status


 -----Inputs----- 
INPUT		TYPE		DESCRIPTION 
iMode		INT		Configuration of Ethernet Link (1 or anyINT Default = ETH1 service port; 
										2   = ETH2 Network Port;
										3   = ETH3 Network Port
										4   = ETH2 ETH3 Network Ports)
iFlt		EBOOL		Simualte Module Not Running Fault (STSDDT.STATE_RUN = 0)
iComFlt		EBOOL		Simulate Internal Communications Failure from Device DDT
iLnkNotAct	EBOOL		Simulate Ethernet link active/inactive (0 = Link Active; 1 = Not Link Active)

-----Outputs-----
OUTPUT 		TYPE 		DESCRIPTION
oInDatDDT	T_M_CRA_EXT_IN	Input Status DDT data to status DFB of CRA31210 Module.

created: AXY 18/10/2022
updated: AXY 12/05/2023
*)

(* =====Set Ethernet Sts Hty===== *)
CASE iMode OF
  2: 
	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := FALSE);
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH2 NETWORK PORT MODE *)
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := FALSE);
  3:
	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := FALSE);
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := FALSE); 	   
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH3 NETWORK PORT MODE *)

  4:
  	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := FALSE);
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH2 NETWORK PORT MODE *)
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* ETH3 NETWORK PORT MODE *)

ELSE
	(* Simluate Ethernet Link Fault *)
	oInDatDDT.ETH_STATUS.0 := WRITE_INPUT_EBOOL( INP := NOT(iLnkNotAct)); (* DEFAULT ETH1 PORT MODE *)
	oInDatDDT.ETH_STATUS.1 := WRITE_INPUT_EBOOL( INP := FALSE); 
	oInDatDDT.ETH_STATUS.2 := WRITE_INPUT_EBOOL( INP := FALSE);
END_CASE;

(* =====Default Hty States===== *)
oInDatDDT.ETH_STATUS.8 := WRITE_INPUT_EBOOL (INP := TRUE); (* NetDiagOK *)
oInDatDDT.SERVICE_STATUS2.0 := WRITE_INPUT_EBOOL (INP:= TRUE); (* RIOAdrOK *)
oInDatDDT.SERVICE_STATUS.14 := WRITE_INPUT_EBOOL (INP:= TRUE); (* ServFDR *)
oInDatDDT.MAIN_IP_ADDRESS_STATUS := WRITE_INPUT_EBOOL (INP:= TRUE); (* Duplicate Ip *)

(* =====Fault Mapping===== *)
(* Redundancy Error Sim *)
oInDatDDT.ETH_STATUS.5 := WRITE_INPUT_EBOOL (INP := NOT( iRdnFlt)); (* RdnOK *)

(* ScnOK *)
oInDatDDT.ETH_STATUS.6 := WRITE_INPUT_EBOOL (INP := Not( iLnkNotAct)); (* ScnOK *)

(* Network Fault *)
oInDatDDT.ETH_BKP_FAILURE := WRITE_INPUT_EBOOL (INP := NOT(iFlt)); (* BK plane fault *)
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="sim_CBSts" version="0.15" dateTime="dt#2024-02-12-10:19:03">
		<comment>Circuit Breaker Sim Block (All output are mutually exclusive)</comment>
		<attribute name="TypeCodeCheckSumString" value="92D8"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="9511"></attribute>
		<inOutParameters>
			<variables name="ioSetTripped" typeName="EBOOL">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="ioReset" typeName="EBOOL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="ioSetOpen" typeName="EBOOL">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="oClsd" typeName="EBOOL">
				<comment>Circuit Breaker Closed Status (1 = Closed)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="oTrpd" typeName="EBOOL">
				<comment>Circuit Breaker Tripped Status (1 = Tripped)</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="SetTrip" typeName="EBOOL">
				<comment>Local Set Trip Status Bit (1 = Set Trip)</comment>
			</variables>
			<variables name="SetOpen" typeName="EBOOL">
				<comment>Local Set Open Status bit (1 = Set Open)</comment>
			</variables>
			<variables name="TON_0" typeName="TON"></variables>
			<variables name="ResetCB" typeName="EBOOL">
				<comment>Reset Circuit Breaker Status</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="sim_CBStatus">
			<STSource>(* Reset IO to 0 *)
SetTrip := MOVE (IN := ioSetTripped );
ioSetTripped := MOVE (IN := 0 );

SetOpen := MOVE (IN := ioSetOpen);
ioSetOpen := MOVE (IN := 0 );

TON_0 (IN := ioReset,
       PT := t#1s,
       Q =&gt; ResetCB);

IF ioReset THEN
	oTrpd := 0;
	oClsd := 0;
END_IF;

IF ResetCB OR %s21 THEN 
	ioReset := 0;
	oTrpd := 0;
	oClsd := 1;
END_IF;






IF SetTrip THEN
	oTrpd := 1;
	oClsd := 0;
END_IF;



IF SetOpen THEN 	
	oTrpd := 0;
	oClsd := 0;
END_IF;
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="SIM_CRA31210" version="0.37" dateTime="dt#2026-09-01-11:17:19">
		<comment>Simulates X80 32 Channel Digital input module statuses</comment>
		<attribute name="TypeCodeCheckSumString" value="9582"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="165F"></attribute>
		<inputParameters>
			<variables name="iMode" typeName="INT">
				<comment>Configuration of Ethernet Link (1=ETH1, 2=ETH2, 3=ET3, default = ETH1)</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iFlt" typeName="EBOOL">
				<comment>Simualte Module Not Running Fault (1= Faulted not running)</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iComFlt" typeName="EBOOL">
				<comment>Simulate Internal Communications Failure from Device DDT (1= Faulted)</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iLnkNotAct" typeName="EBOOL">
				<comment>Simulate Ethernet link active/inactive (0 = Link Active; 1 = Not Link Active)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oInDatDDT" typeName="T_M_CRA_EXT_IN">
				<comment>Input Status DDT data to status DFB of CRA31210 Module.</comment>
