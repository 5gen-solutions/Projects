							<objPosition posX="44" posY="126"></objPosition>
						</linkDestination>
					</linkFB>
					<linkFB>
						<linkSource parentObjectName=".26" pinName="OUT">
							<objPosition posX="25" posY="148"></objPosition>
						</linkSource>
						<linkDestination parentObjectName=".30" pinName="IN1">
							<objPosition posX="29" posY="145"></objPosition>
