			<variables name="iTstStt" typeName="BOOL">
				<comment>Initiation of test (Eg: start pushbutton pressed in the field)</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iTstEqpMode" typeName="BOOL">
				<comment>Equipment is in the required mode for the test (Eg: Local mode)</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="iTstCndRdy" typeName="BOOL">
				<comment>Test conditions are ready (eg: CB open, I/O modules healthy etc)</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oTstDet" typeName="BOOL">
				<comment>Detection that a test was attempted</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
