		<FBProgram name="CordexAlarm">
			<STSource>(* Create a string of the alarms for PLC display *)

IF NOT oCordexDatOK THEN
	oCordexAlmTxt := 'Data invalid, no Cordex alarms to show';
ELSE
	oCordexAlmTxt := '';
	
	IF RECP2[0].0 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'AC Input Voltage High, ');
	END_IF;

	IF RECP2[0].1 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'AC Input Voltage Low, ');
	END_IF;

	IF RECP2[0].2 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Long Term AC Input Fail, ');
	END_IF;

	IF RECP2[0].3 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Output Voltage High, ');
	END_IF;

	IF RECP2[0].4 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Output Voltage Very High, ');
	END_IF;

	IF RECP2[0].5 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Output Voltage Low, ');
	END_IF;

	IF RECP2[0].6 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Output Voltage Very Low, ');
	END_IF;

	IF RECP2[0].7 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Invalid System Voltage Reading, ');
	END_IF;

	IF RECP2[0].9 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Rectifier Fail, ');
	END_IF;

	IF RECP2[0].10 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Rectifier Fail Count Very High, ');
	END_IF;

	IF RECP2[0].11 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Rectifier Fail Count High, ');
	END_IF;

	IF RECP2[0].12 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Rectifier Minor, ');
	END_IF;

	IF RECP2[0].13 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Rectifier Communication Lost, ');
	END_IF;

	IF RECP2[0].14 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'AC Input Fail, ');
	END_IF;

	IF RECP2[0].15 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Fan Fail, ');
	END_IF;

	IF RECP2[1].3 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Battery Runtime Low, ');
	END_IF;

	IF RECP2[1].5 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Rectifier Configuration Error, ');
	END_IF;

	IF RECP2[1].6 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Insufficient Capacity Remaining (A), ');
	END_IF;

	IF RECP2[1].7 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Insufficient Capacity Remaining (W), ');
	END_IF;

	IF RECP2[1].8 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Missing Rectifier, ');
	END_IF;

	IF RECP2[1].9 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Rectifier AC Fail Count High, ');
	END_IF;

	IF RECP2[1].10 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Rectifier AC Fail Count Very High, ');
	END_IF;

	IF RECP2[1].11 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Total Load Current High, ');
	END_IF;

	IF RECP2[1].12 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Total Load Current Very High, ');
	END_IF;

	IF RECP2[1].13 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Voltage Regulation Suspended, ');
	END_IF;

	IF RECP2[9].12 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Battery Charge Current High, ');
	END_IF;

	IF RECP2[9].13 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Battery Temperature High, ');
	END_IF;

	IF RECP2[9].14 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Battery Temperature Low, ');
	END_IF;

	IF RECP2[9].15 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Battery Breaker/Fuse Open, ');
	END_IF;

	IF RECP2[10].2 THEN
		oCordexAlmTxt := CONCAT_STR(oCordexAlmTxt, 'Battery Temperature Anomaly, ');
	END_IF;

	IF oCordexAlmTxt = '' THEN
  		oCordexAlmTxt := 'No Cordex Alarms Active';
	ELSE
		oCordexAlmTxt := REPLACE_INT(oCordexAlmTxt,'', 2, LEN_INT(oCordexAlmTxt)-1);
	END_IF;

END_IF;
</STSource>
		</FBProgram>
