							<outputVariable invertedPin="false" formalParameter="BIT10" effectiveParameter="oStsDDT.DIS_CH_OUT[10].VALUE"></outputVariable>
							<outputVariable invertedPin="false" formalParameter="BIT11" effectiveParameter="oStsDDT.DIS_CH_OUT[11].VALUE"></outputVariable>
							<outputVariable invertedPin="false" formalParameter="BIT12" effectiveParameter="oStsDDT.DIS_CH_OUT[12].VALUE"></outputVariable>
							<outputVariable invertedPin="false" formalParameter="BIT13" effectiveParameter="oStsDDT.DIS_CH_OUT[13].VALUE"></outputVariable>
							<outputVariable invertedPin="false" formalParameter="BIT14" effectiveParameter="oStsDDT.DIS_CH_OUT[14].VALUE"></outputVariable>
							<outputVariable invertedPin="false" formalParameter="BIT15" effectiveParameter="oStsDDT.DIS_CH_OUT[15].VALUE"></outputVariable>
						</descriptionFFB>
					</FFBBlock>
					<linkFB>
						<linkSource parentObjectName=".1" pinName="OUT">
							<objPosition posX="22" posY="83"></objPosition>
