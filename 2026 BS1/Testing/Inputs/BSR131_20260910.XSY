				<comment>Cyclic Mode Command based on Number of Starts and RunHours</comment>
			</variables>
			<variables name="CyclicAcc" typeName="BOOL">
				<comment>Priority Selection Mode is Cyclic Based on Number of Starts and RunHours</comment>
			</variables>
			<variables name="BiasRH" typeName="DINT">
				<comment>Top Priority Equipment Bias Value for RunHours</comment>
			</variables>
			<variables name="StartTrig" typeName="R_TRIG">
				<comment>Running Edge Trigger</comment>
			</variables>
			<variables name="Started" typeName="BOOL">
				<comment>Unlatch Change Event</comment>
			</variables>
			<variables name="Changed" typeName="BOOL">
				<comment>A Change in Accumulated Priority has occurred</comment>
			</variables>
			<variables name="StartsOR" typeName="DINT">
				<comment>Consectutive Starts Override Value when Mode Accumulated RunHours</comment>
			</variables>
			<variables name="EquipChange" typeName="INT">
				<comment>Equipment Number to Act On</comment>
			</variables>
			<variables name="PriorityChange" typeName="INT">
				<comment>Priority Number to Switch Too</comment>
			</variables>
			<variables name="RunList" typeName="ARRAY[1..6] OF INT">
				<comment>Accumulated RunHours Array from Lowest to Highest [P1 EquipNum, P2 EquipNum, .....]</comment>
			</variables>
			<variables name="OldRunList" typeName="ARRAY[1..6] OF INT">
				<comment>Last Update RunHours Listing</comment>
			</variables>
			<variables name="NextRun" typeName="INT">
				<comment>Next to Run Equipment Number</comment>
			</variables>
			<variables name="ReSort" typeName="ARRAY[1..6] OF INT">
				<comment>Re-ordering of Priority Array when Rolling Table</comment>
			</variables>
			<variables name="DemandTimer" typeName="TON">
				<comment>Time Delay Operation for Unable to Make Demand Alarm</comment>
			</variables>
			<variables name="Cyc_Init" typeName="R_TRIG"></variables>
			<variables name="FirstCycle" typeName="BOOL">
				<comment>First Cycle of Code in Accumulated Mode</comment>
			</variables>
			<variables name="RollSttOR" typeName="BOOL">
				<comment>Roll Required due to Starts Override</comment>
			</variables>
			<variables name="RollReturn" typeName="BOOL">
				<comment>Roll Required as Returning from Starts Override</comment>
			</variables>
			<variables name="StartOrder" typeName="ARRAY[1..6] OF INT">
				<comment>Equipment Started in Order of Priority</comment>
			</variables>
			<variables name="CurEquipNum" typeName="INT">
				<comment>Current Equipment Number in New Selected Priority (Fixed Mode)</comment>
			</variables>
			<variables name="NewEquipPtr" typeName="INT">
				<comment>Priority Position in New Equipment (Fixed Mode)</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="Priority">
			<STSource>(*
KP_PriSel {V(G)=17}
*******************

The Priority Selection object carries out the selection of the highest priority equipment
available based on the demand required, for between 2 and 6 equipment.

The mode of operation is one of the following:
* Fixed – Priority order set by Operator
* Cyclic based on Number of Starts – Priority is rotated when the equipment currently selected
  as P1 reaches the number of starts setpoint
* Cyclic based on Differential RunHours – Priority is rotated when the equipment currently selected as P1
  reaches the RunHours setpoint
* Cyclic based on Accumulated RunHours – Priority is rotated based on lowest total accumulated runhours,
  with a consective starts override

PriSel is set up as follows:
Element one of the array is highest priority Equip Number
Element two of the array is next highest priority Equip Number
.
.
Element six of the array is lowest priority Equip Number

Revision

05/11/24 09:24 - MBT - Created a version for PDO command word
19/09/14 12:30 - SPL - Fixed Mode Selection Revised
9/11/12 11:38 - MBT - Revision changed to meet STD-J-010
Rev 0.2 SPL 24/09/12 - Equipment Required To Run outputs reset when the demand is = 0 
Rev 0.1 MBT 17/02/12 - Changed dPriCtl to dCtl
Rev 0.0 MBT 22/09/11 - Available for Use
Rev B.8 MBT 01/09/11 - Initialised Bias Selections to stop cycling when all = 0
Rev B.7 MBT 25/08/11 - Correction of demand change ordering issue
Rev B.6 MBT 23/05/11 - Corrected Cyclicing issue in Cyclic Acc mode	
Rev B.4 MBT 04/05/11 - Changing running status to include AutOK
Rev B.3 MBT 22/03/11 - Cycling issue when same runhours in accumulated mode fixed.
Rev B.2 MBT 18/03/11 - Overflow index error fixed, Update Pointer set to zero when calculating priority order based on run hours.
Rev B.2 MBT 23/02/11 - Added Demand Alarm.
Rev B.1 MBT 04/02/11 - Added ability for Accumulated RunHours.
Rev B.0 MBT 24/11/11 - Converted to ST, expanded to 6 equipment, added control mode selections
Rev A.0 MBT 15/07/10 - Initial Release (in FBD)
 
*)

(* The minimum number of equipment the object operates on is 2, and a maximum of 6.
The consectutive starts setpoint for accumulated run hours must be &gt;= 1. 
Check to ensure that the values entered are within the limits of the object *)
NumEquip := LIMIT (MN := 2, IN := iEqpNum, MX := 6);
StartsOR := MAX(IN1 := iOvrStt, IN2 := 1);

(* If first scan, then initialise values for priority selection and bias else cycling occurs *)
FirstScan := NOT (%SW10.0);

IF FirstScan THEN
	FOR i := 1 TO NumEquip BY 1 DO
		dPriSel[i] := i;
		OldRunList[i] := i;
		dBiaSel[i] := 1;
	END_FOR;
END_IF;

(* Break out the command selection word into the individual bits *)

FixedCMD := iCtl.0;
CyclicSttCMD := iCtl.2;
CyclicRunCMD := iCtl.3;
CyclicAccCMD := iCtl.4;

(* Determine the Required operation mode selected, with Fixed being the default *)
CyclicStt := (CyclicSttCmd OR CyclicStt) AND NOT(FixedCmd OR CyclicRunCMD OR CyclicAccCMD);
CyclicRun := (CyclicRunCmd OR CyclicRun) AND NOT(FixedCmd OR CyclicSttCMD OR CyclicAccCMD);
CyclicAcc := (CyclicAccCMD OR CyclicAcc) AND NOT(FixedCmd OR CyclicSttCMD OR CyclicRunCMD);
Cyclic := CyclicStt OR CyclicRun OR CyclicAcc;
Fixed := (FixedCmd OR Fixed OR NOT Cyclic) AND NOT(CyclicSttCMD OR CyclicRunCMD OR CyclicAccCMD);

(* Determine if a change in priorities has been selected by the operator, and if so, 
automatically update the table to reflect the change by setting the conflicting priority
to that of the old change priority value.  Note that in CyclicAcc mode, the operator can
not effect the priority table *) 

(* determine which equipment is being reassigned, with the command value set as 
EquipNum*10 + Priority *)
EquipChange 	:= dCmdID / 10;
(* determine the new priority for the equipment *)
PriorityChange 	:= dCmdID MOD 10;

(* Check boundary values *)
IF NOT(CyclicAcc) AND (EquipChange &gt;= 1 AND EquipChange &lt;= NumEquip AND PriorityChange &gt;= 1 AND PriorityChange &lt;= NumEquip) THEN
	(* find previous position of the equipment in the array.
	Note, even though dPriSel array	starts at element 1.  The function assumes the first
	element starts at 0.  This is why the + 1 is used *)
	NewEquipPtr := FIND_EQP_ARINT(dPriSel,EquipChange,0) + 1;
	(* find the equipment number in the new selected priority *)
	CurEquipNum := dPriSel[PriorityChange];
	(* copy the equipment to the new selected position *)
	dPriSel[PriorityChange] := EquipChange;
	(* copy the displaced equipment to the previous position of the reassigned equipment *)
	dPriSel[NewEquipPtr] := CurEquipNum;
	
END_IF;

dCmdID := 0;

(* The run status array is indexed by equipment number and contains the running status of the drive *)
(* Determine number of equipment running *)
RunStatus[1] := iARun AND iAAutOK;
RunStatus[2] := iBRun AND iBAutOK;
RunStatus[3] := iCRun AND iCAutOK;
RunStatus[4] := iDRun AND iDAutOK;
RunStatus[5] := iERun AND iEAutOK;
RunStatus[6] := iFRun AND iFAutOK;

(* Initialise count of running equipment *)
RunTotal := 0;

FOR i := 1 TO NumEquip DO
	IF RunStatus[i] THEN
		RunTotal := RunTotal + 1;
	END_IF;
END_FOR;

EquipRunning := RunTotal &gt; 0;

(* Calculate an array of equipment sorted by run hours *)
(* Initialise Values *)
i := 1;
RunList := dPriSel;
(* On first entering Cyclic Accumulated mode, set the old run list equal to the current run list.
Else if the run hours are the same at entering mode then the priority's continue to cycle *)
Cyc_Init (CLK := CyclicAcc, Q =&gt; FirstCycle);
IF FirstCycle THEN
	OldRunList := RunList;
END_IF;

WHILE i &lt; NumEquip DO
	(* Check if we need to flip these items *)
	IF iEqpRunHr[RunList[i]] &gt; iEqpRunHr[RunList[i + 1]] THEN (* &gt; *)
		(* Flip entry with the next in the list *)
		j := RunList[i];
		RunList[i] := RunList[i + 1];
		RunList[i + 1] := j;
		(* recheck the previous condition *)
		i := MAX(i - 1,1);
	ELSE
		(* Direct increment if check works ok *)
		i := i + 1;
	END_IF;
END_WHILE;

(* If the run hours list has changed then trigger an update *)
Changed := CyclicAcc AND (EQUAL_ARINT(IN1 := RunList, IN2 := OldRunList, P := 1) &gt; 0);

(* Only run the determination of rotation of priorities if the selected mode is Cyclic.  Required to be run also
on First Scan to load the current values into the counters *)
	
(* Calculate the rollover requirements based upon the primary equipment*)
BiasStt := dBiaSel[dPriSel[1]];
BiasRH := dBiaSel[dPriSel[1]] * 3600; (* convert hours to seconds *)
Running := RunStatus[dPriSel[1]];
	
(* Accumulate starts for the duty equipment *)
StartTrig (CLK := Running, Q =&gt; Started);
IF Started AND Cyclic THEN
	(* Count starts - ensure no overflow by MIN with DINT limit - 1 *)
	dCntVal[1] := MIN(dCntVal[1] + 1,2147483646);
END_IF;

(* Accumulate run seconds for the duty equipment *)
IF Running AND iSecPls AND Cyclic THEN
	(* Count run seconds - ensure no overflow by MIN with DINT limit - 1 *)
	dCntVal[2] := MIN(dCntVal[2] + 1,2147483646);
END_IF;

(* Determine whether an update of the priority list is required *)
RollSttOR := (dCntVal[1] &gt;= StartsOR) AND CyclicAcc; (* based on consectutive number of starts *)
RollReturn := (dCntVal[1] &gt;= 1) AND CyclicAcc AND (dPriSel[1] &lt;&gt; RunList[1]); (* returning after roll due to consectutive starts *)

RollReq := ((dCntVal[1] &gt;= BiasStt)  AND CyclicStt) OR (* based on number of starts *)
	   ((dCntVal[2] &gt; BiasRH)   AND CyclicRun) OR (* runhours *)
	   RollSttOR OR RollReturn;
	
(* Update to new Priority Value only when all equipment is stopped *)
IF Cyclic AND (RollReq OR Changed) AND NOT EquipRunning THEN
	(* Reset accumulated values *)
	dCntVal[1] := 0;
	dCntVal[2] := 0;

	(* Determine sort method required *)
	IF CyclicAcc THEN
		(* If the lowest run time pump is currently running then choose another pump
			This logic will cycle through each of the remaining pumps starting a new one each time *)
		IF NOT(Changed OR RollReturn) THEN 
			(* Copy in the run hours sorted list *)
			dPriSel := RunList;
			(* Pick the next pump to run *)
			NextRun := MAX((NextRun MOD NumEquip) + 1,2);
			(* Assign the next pump to run as the highest priority *)
			dPriSel[1] := RunList[NextRun];
			(* Place the lowest run hours pump into the spot vacated *)
			dPriSel[NextRun] := RunList[1];
		ELSE
			(* ELSE the lowest run time pump was not the highest priority, just copy in the run hours sorted list *)
			dPriSel := RunList;
		END_IF;			
	ELSE	
		(* Rotate current list *)
		FOR i := 1 TO NumEquip DO
			(* Calculate shuffled priority *)
			ReSort[i] := dPriSel[MOD(i,NumEquip) + 1];
		END_FOR;
		(* Copy shuffled priority into active array *)
		dPriSel := ReSort;
	END_IF;

	OldRunList := RunList;
END_IF;

(* Map out states *)

oFix := Fixed;
oCycStt := CyclicStt;
oCycHrs := CyclicRun;
oCycAcc := CyclicAcc;
</STSource>
		</FBProgram>
		<FBProgram name="Starting">
			<STSource>(* Determine the number of equipment required to meet the demand. When the system is not
required, the demand is set to 0, and when required is set to 1 by default, and capped 
at number of Equipment in system*)

Demand := BOOL_TO_INT(iReq) * LIMIT (MN := 1, IN := iEqpReq, MX := NumEquip);

(* Determine the status of each equipment, and place it into an array of format
[EquipA, EquipB, EquipC, ....] where a value of 1 indicates equipment healthy *)
Status[1] := iAAutOK;
Status[2] := iBAutOK;
Status[3] := iCAutOK;
Status[4] := iDAutOK;
Status[5] := iEAutOK;
Status[6] := iFAutOK;

(* When the demand is different to the current running value, loop through the selection
array to find priority 1.  If its status is healthy, and the running demand has not been 
satisfied, then set its start command bit.  Continue through the loop and either start or
stop the equipment based on the demand required. *)
IF Demand &gt; RunTotal THEN
	RunDemand := Demand - RunTotal;
	j := 1;
	FOR i := 1 TO NumEquip DO
		IF (Status[dPriSel[i]] AND NOT(RunStatus[dPriSel[i]]) AND RunDemand &gt; 0) THEN
			Start[dPriSel[i]] := TRUE;
			RunDemand := RunDemand - 1;
			StartOrder[j] := dPrisel[i];
			j := j + 1;			
		ELSE IF RunStatus[dPriSel[i]] THEN
			StartOrder[j] := dPrisel[i];
			j := j + 1;
		     ELSE
			Start[dPriSel[i]] := FALSE;
		     END_IF;
		END_IF;
	END_FOR;
END_IF;

IF Demand &lt; RunTotal THEN
	RunDemand := RunTotal - Demand;
	FOR i := NumEquip TO 1 BY -1 DO
		IF (StartOrder[i] &gt; 0 AND RunDemand &gt; 0) THEN
			Start[StartOrder[i]] := FALSE;
			RunDemand := RunDemand - 1;
			StartOrder[i] := 0;
		END_IF;
	END_FOR;
END_IF;

(* When equipment is not required ensure the equipment required signals are not set *)
IF Demand = 0 THEN
	FOR i := NumEquip TO 1 BY -1 DO
		Start[i] := FALSE;       
	END_FOR;
END_IF;

(* If the demand can not be met, then raise a fault indication *)
DemandTimer (IN := Demand &gt; RunTotal, PT := iFltTm,
             Q =&gt; oFlt);

(* Map the start command to the equipment required output *)
oAReq := Start[1];
oBReq := Start[2];
oCReq := Start[3];
oDReq := Start[4];
oEReq := Start[5];
oFReq := Start[6];
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="MasterPactMTZ" version="1.00" dateTime="dt#2026-07-07-14:13:03">
