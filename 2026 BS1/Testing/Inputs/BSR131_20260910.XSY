		<FBProgram name="BACSSysAlarm">
			<STSource>(* Alarms are split across 3 16 bit registers with 1 = alarm active and 0 = alarm not active *)



(* Create a string of the alarms for PLC display *)

IF NOT oBACSDatOK THEN
	oBACSSysAlmTxt := 'Data invalid, no BACS system alarms to show';
ELSE
	oBACSSysAlmTxt := '';

	IF iDatDDT1.BACSSysDatIn[1].1 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Voltage Differential High, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].2 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Battery Breaker Open, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].3 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Thermal Runaway, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].4 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Sensor Lost, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].5 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'String Voltage High, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].6 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'String Voltage Low, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].7 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'String Voltage High Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].8 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'String Voltage Low Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].9 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'String Current High, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].10 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'String Current Low, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].11 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'String Current High Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].12 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'String Current Low Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].13 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Current Out of Range, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].14 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Ground Fault Detected, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[1].15 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Sensor Connection Lost, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].1 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Communication Lost, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].2 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Voltage High, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].3 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Voltage Low, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].4 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Temperature High, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].5 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Temperature Low, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].6 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Resistor High, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].7 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Resistor Low, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].8 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Equalisation Error, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].9 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Voltage High Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].10 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Voltage Low Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].11 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Temperature High Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].12 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Temperature Low Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].13 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Resistor High Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].14 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Resistor Low Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[2].15 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Module Incompatible, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].0 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Current Sensor High, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].1 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Current Sensor Low, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].2 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Current Sensor High Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].3 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Current Sensor Low Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].4 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Equalizing Cutoff, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].5 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Discharge Current Deviation, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].6 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Charge Current Deviation, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].7 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Discharge Current Deviation Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].8 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Charge Current Deviation Warning, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].9 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'RCM Current Difference, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].10 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Current Sensor Connection Lost, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].11 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'Aux Connection Lost, ');
	END_IF;
	
	IF iDatDDT1.BACSSysDatIn[5].12 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'String Charge Low, ');
	END_IF;

	IF iDatDDT1.BACSSysDatIn[5].13 THEN
		oBACSSysAlmTxt := CONCAT_STR(oBACSSysAlmTxt, 'String Charge Low Warning, ');
	END_IF;

	IF oBACSSysAlmTxt = '' THEN
  		oBACSSysAlmTxt := 'No BACS System Alarms Active';
	ELSE
		oBACSSysAlmTxt := REPLACE_INT(oBACSSysAlmTxt,'', 2, LEN_INT(oBACSSysAlmTxt)-1);
	END_IF;

END_IF;
</STSource>
		</FBProgram>
		<FBProgram name="BACSModAlarm">
			<STSource>(* Each module's alarm register is a 16 bit register with 1 = alarm active and 0 = alarm not active *)



(* Create a string of the alarms for PLC display *)

BACSFrstFltModIdx := 0;
BACSFrstFltModNum := 0;

FOR j := 3 TO 43 BY 5 DO
	BACSFrstFltModNum := j - 3;

	IF BACSFrstFltModNum &gt; 0 THEN
		BACSFrstFltModNum := (BACSFrstFltModNum / 5);
	END_IF;

	BACSFrstFltModNum := BACSFrstFltModNum + 1;

	IF iDatDDT1.BACSMod1_9DatIn[j] &lt;&gt; 0 THEN
		BACSFrstFltModIdx := j;
		EXIT;
	END_IF;
END_FOR;

IF NOT oBACSDatOK THEN
	oBACSModAlmTxt := 'Data invalid, no BACS module alarms to show';
ELSIF BACSFrstFltModIdx &lt;&gt; 0 THEN
	oBACSModAlmTxt := '';

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].1 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Communication Lost, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].2 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Voltage High, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].3 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Voltage Low, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].4 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Temperature High, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].5 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Temperature Low, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].6 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Resistor High, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].7 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Resistor Low, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].8 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Equalisation Error, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].9 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Voltage High Warning, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].10 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Voltage Low Warning, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].11 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Temperature High Warning, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].12 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Temperature Low Warning, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].13 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Resistor High Warning, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].14 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Resistor Low Warning, ');
	END_IF;

	IF iDatDDT1.BACSMod1_9DatIn[BACSFrstFltModIdx].15 THEN
		oBACSModAlmTxt := CONCAT_STR(oBACSModAlmTxt, 'Module Incompatible, ');
	END_IF;

	IF oBACSModAlmTxt = '' THEN
		oBACSModAlmTxt := CONCAT_STR(CONCAT_STR(CONCAT_STR('Module ', INT_TO_STRING(BACSFrstFltModNum)), ':'), 'General Alarm Active');
	ELSE
  		oBACSModAlmTxt := CONCAT_STR(CONCAT_STR(CONCAT_STR('Module ', INT_TO_STRING(BACSFrstFltModNum)), ':'), REPLACE_INT(oBACSModAlmTxt,'', 2, LEN_INT(oBACSModAlmTxt)-1));
	END_IF;
ELSE
	oBACSModAlmTxt := 'No BACS Module Alarms Active';
END_IF;
</STSource>
		</FBProgram>
	</FBSource>
