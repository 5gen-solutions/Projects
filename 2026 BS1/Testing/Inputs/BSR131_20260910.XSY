							<outputVariable invertedPin="false" formalParameter="OUT"></outputVariable>
						</descriptionFFB>
					</FFBBlock>
					<linkFB>
						<linkSource parentObjectName=".35" pinName="OUT">
							<objPosition posX="27" posY="26"></objPosition>
						</linkSource>
						<linkDestination parentObjectName=".36" pinName="IN1">
							<objPosition posX="32" posY="26"></objPosition>
