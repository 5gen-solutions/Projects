		<FBProgram name="Main">
			<STSource>(* Diag_CTU
   31 counters log activity on inputs In1..In31 for diagnostic purposes.
   Counter values appear on outputs Cv1..Cv31
   Each counter can be reset individually by entering the counter number in integer input Reset.
   All counters can be reset simultaneously by entering -1 into Reset.

   Rev 0   J. Downs  Worley  12/5/2021
*)

CTU_1 (CU := In1, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 1 OR Reset = -1), CV =&gt; Cv1);
CTU_2 (CU := In2, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 2 OR Reset = -1), CV =&gt; Cv2);
CTU_3 (CU := In3, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 3 OR Reset = -1), CV =&gt; Cv3);
CTU_4 (CU := In4, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 4 OR Reset = -1), CV =&gt; Cv4);
CTU_5 (CU := In5, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 5 OR Reset = -1), CV =&gt; Cv5);
CTU_6 (CU := In6, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 6 OR Reset = -1), CV =&gt; Cv6);
CTU_7 (CU := In7, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 7 OR Reset = -1), CV =&gt; Cv7);
CTU_8 (CU := In8, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 8 OR Reset = -1), CV =&gt; Cv8);
CTU_9 (CU := In9, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 9 OR Reset = -1), CV =&gt; Cv9);
CTU_10 (CU := In10, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 10 OR Reset = -1), CV =&gt; Cv10);
CTU_11 (CU := In11, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 11 OR Reset = -1), CV =&gt; Cv11);
CTU_12 (CU := In12, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 12 OR Reset = -1), CV =&gt; Cv12);
CTU_13 (CU := In13, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 13 OR Reset = -1), CV =&gt; Cv13);
CTU_14 (CU := In14, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 14 OR Reset = -1), CV =&gt; Cv14);
CTU_15 (CU := In15, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 15 OR Reset = -1), CV =&gt; Cv15);
CTU_16 (CU := In16, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 16 OR Reset = -1), CV =&gt; Cv16);
CTU_17 (CU := In17, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 17 OR Reset = -1), CV =&gt; Cv17);
CTU_18 (CU := In18, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 18 OR Reset = -1), CV =&gt; Cv18);
CTU_19 (CU := In19, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 19 OR Reset = -1), CV =&gt; Cv19);
CTU_20 (CU := In20, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 20 OR Reset = -1), CV =&gt; Cv20);
CTU_21 (CU := In21, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 21 OR Reset = -1), CV =&gt; Cv21);
CTU_22 (CU := In22, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 22 OR Reset = -1), CV =&gt; Cv22);
CTU_23 (CU := In23, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 23 OR Reset = -1), CV =&gt; Cv23);
CTU_24 (CU := In24, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 24 OR Reset = -1), CV =&gt; Cv24);
CTU_25 (CU := In25, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 25 OR Reset = -1), CV =&gt; Cv25);
CTU_26 (CU := In26, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 26 OR Reset = -1), CV =&gt; Cv26);
CTU_27 (CU := In27, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 27 OR Reset = -1), CV =&gt; Cv27);
CTU_28 (CU := In28, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 28 OR Reset = -1), CV =&gt; Cv28);
CTU_29 (CU := In29, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 29 OR Reset = -1), CV =&gt; Cv29);
CTU_30 (CU := In30, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 30 OR Reset = -1), CV =&gt; Cv30);
CTU_31 (CU := In31, R := (Reset &lt;&gt; Prev_Reset) AND (Reset = 31 OR Reset = -1), CV =&gt; Cv31);

Prev_Reset := Reset;
</STSource>
		</FBProgram>
	</FBSource>
