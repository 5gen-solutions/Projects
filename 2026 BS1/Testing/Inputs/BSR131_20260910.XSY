				<comment>Module Failure Detected</comment>
			</variables>
			<variables name="ChFlt" typeName="EBOOL">
				<comment>Channel Fault Detected</comment>
			</variables>
			<variables name="EqpFlt" typeName="EBOOL">
				<comment>Module Terminal Block Error Detected</comment>
			</variables>
			<variables name="IntTst" typeName="EBOOL">
				<comment>Module Start Up Self Test Active</comment>
