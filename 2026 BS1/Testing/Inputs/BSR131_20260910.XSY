		<FBProgram name="TestClockSystem">
			<STSource>If (GT_INT (HoursDec,23) or GT_INT (0,HoursDec)) THEN
	ErrorClockSystem := 1;
ELSIf (GT_INT (MinutesDec,59) or GT_INT (0,MinutesDec)) THEN
	ErrorClockSystem := 1;
ELSIf (GT_INT (MonthDec,12) or GT_INT (0,MonthDec)) THEN
	ErrorClockSystem := 1;
ELSIf (GT_INT (DayDec,31) or GT_INT (0,DayDec)) THEN
	ErrorClockSystem := 1;
ELSIf (GT_INT (YearDec,99) or GT_INT (0,YearDec)) THEN
	ErrorClockSystem := 1;
ELSIf (GT_INT (SecondsDec,59) or GT_INT (0,SecondsDec)) THEN
	ErrorClockSystem := 1;
ELSIf (GT_INT (DayOfWeek,7) or GT_INT (1,DayOfWeek)) THEN
	ErrorClockSystem := 1;
ELSE ErrorClockSystem :=0;
END_IF ;
</STSource>
		</FBProgram>
		<FBProgram name="TestClockScada">
			<STSource>(* 	AddrReference(1) 	: Day of the Week
 	AddrReference(2)	: Seconds
 	AddrReference(3)	: Minutes 
 	AddrReference(4) 	: Hours
 	AddrReference(5)	: Day
 	AddrReference(6)	: Month
 	AddrReference(7)	: Year *)

If (GT_INT (AddrReference[3],59) or GT_INT (0,AddrReference[3])) THEN
	ErrorClockScada := 1;

ELSIF (GT_INT (AddrReference[4],23) or GT_INT (0,AddrReference[4])) THEN
	ErrorClockScada := 1;

ELSIF (GT_INT (AddrReference[5],31) or GT_INT (0,AddrReference[5])) THEN
	ErrorClockScada := 1;

ELSIF (GT_INT (AddrReference[6],12) or GT_INT (0,AddrReference[6])) THEN
	ErrorClockScada := 1;

ELSIF (GT_INT (AddrReference[1],7) or GT_INT (1,AddrReference[1])) THEN
	ErrorClockScada := 1;

ELSIF (GT_INT (AddrReference[2],59) or GT_INT (0,AddrReference[2])) THEN
	ErrorClockScada := 1;

ELSIF (GT_INT (AddrReference[7],99) or GT_INT (0,AddrReference[7])) THEN
	ErrorClockScada := 1;

ELSE ErrorClockScada := 0;
END_IF ;
</STSource>
		</FBProgram>
		<FBProgram name="HexToDec">
			<STSource>(*Year*)
Y1 := Year / 4096;
Y2 := (Year - Y1*4096) / 256;
Y3 := (Year - Y1*4096 - Y2 *256) / 16;
Y4 := Year - Y1*4096 - Y2 *256 - Y3*16;
YearDec := Y3*10 + Y4;

(*Seconds*)
S1 := Seconds / 4096;
S2 := (Seconds - S1*4096)/256;
SecondsDec := S1 * 10 + S2;

(*Hours*)
H1 := Hours / 16;
H2 := Hours - H1*16;
HoursDec := H1*10 + H2;

(*Minutes*)
M1 := Minutes/16;
M2 := Minutes - M1*16;
MinutesDec := M1*10 + M2;

(*Month*)
Mo1 := Month / 16;
Mo2 := Month - Mo1 *16;
MonthDec := Mo1*10 + Mo2;
 
(*Day*)
D1 := Day/16;
D2 := Day - D1*16;
DayDec := D1*10 + D2;

(*Day Of Week String*)
CASE DayOfWeek OF
	1:DayOfWeekStr:='Monday';
	2:DayOfWeekStr:='Tuesday';
	3:DayOfWeekStr:='Wednesday';
	4:DayOfWeekStr:='Thursday';
	5:DayOfWeekStr:='Friday';
	6:DayOfWeekStr:='Saturday';
	7:DayOfWeekStr:='Sunday';
END_CASE;
</STSource>
		</FBProgram>
		<FBProgram name="SetDTOut">
			<STSource>
	B2 := AddrReference[2]/10;
	SwapArray[1] := B2* 4096 + (AddrReference[2]-B2*10)*256;(* Set the seconds on the MSB*)
	
	B31 := AddrReference[4]/10;
	B32 := AddrReference[4] - B31*10;
	B41 := AddrReference[3]/10;
	B42 := AddrReference[3] - B41*10;
	SwapArray[2] := B31*4096 + B32*256 + B41*16 + B42;	
					(* Set the Hours on the MSB and the Minutes on the LSB*)	
	
	B51 := AddrReference[6]/10;
	B52 := AddrReference[6] - B51*10;
	B61 := AddrReference[5]/10;
	B62 := AddrReference[5] - B61*10;
	SwapArray[3] := B51*4096 + B52*256 + B61*16 + B62;
					(* Set the Month on the MSB and the Day on the LSB *)
	B71 := AddrReference[7]/1000;
	B72 := (AddrReference[7] - B71*1000)/100;
	B73 := (AddrReference[7] - B71*1000 - B72*100)/10;
	B74 := AddrReference[7] - B71*1000 - B72*100 - B73*10;
	SwapArray[4] := B71*4096 + B72*256 + B73*16 + B74;	(* Set the Year*)




SetDT:=ARINT_TO_DT (IN :=SwapArray);
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="PROC_Linear" version="0.13" dateTime="dt#2024-02-12-10:19:16">
		<attribute name="TypeCodeCheckSumString" value="EDF3"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="BA00"></attribute>
		<inputParameters>
			<variables name="iActv" typeName="EBOOL">
				<comment>Process Active</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="iRate" typeName="REAL">
				<comment>Rate of Change (Units/s)</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iDrft" typeName="REAL">
				<comment>Any Drift (units/s)</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iMax" typeName="REAL">
				<comment>Max PV Eng Out Value </comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iMin" typeName="REAL">
				<comment>Min PV Eng Out</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="iScan" typeName="DINT">
				<comment>PLC Scantime</comment>
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
			<variables name="iRand_LL" typeName="REAL">
				<comment>Lower Random Number Limit</comment>
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
			<variables name="iRand_UL" typeName="REAL">
				<comment>Upper Random Number imit</comment>
				<attribute name="PositionPin" value="10"></attribute>
			</variables>
			<variables name="iFrzVal" typeName="EBOOL">
				<comment>Remove Random Number Modifier</comment>
				<attribute name="PositionPin" value="15"></attribute>
			</variables>
			<variables name="iEngMin" typeName="REAL">
				<comment>Eng Min for Scaling (=0)</comment>
				<attribute name="PositionPin" value="11"></attribute>
			</variables>
			<variables name="iEngMax" typeName="REAL">
				<comment>Eng Max for Scaling to raw (=10000)</comment>
				<attribute name="PositionPin" value="12"></attribute>
			</variables>
			<variables name="iOvrPV" typeName="EBOOL">
				<comment>Override PV number</comment>
				<attribute name="PositionPin" value="14"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="dPV" typeName="REAL">
				<comment>PV</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="oPVEng" typeName="REAL">
				<comment>Simulated PV Eng Units</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="oPVPer" typeName="REAL">
				<comment>Simulated Raw value 0-100% of scale</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="delta" typeName="REAL"></variables>
			<variables name="Simulation_Random_Number_0" typeName="Simulation_Random_Number"></variables>
			<variables name="Rand_Num" typeName="REAL">
				<comment>Random Number</comment>
			</variables>
			<variables name="RawMin" typeName="REAL">
				<comment>Raw Min for AI scaling</comment>
			</variables>
			<variables name="RawMax" typeName="REAL">
				<comment>Raw Max for AI Scaling</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="PROC_Linear">
			<STSource>(*------------------------------------------------------------------------------

LINEAR PROCESS SIMULATION

dPV		Process value

iActv		Process is active
iRate		Rate of change when process is active (units/s)
iDrft		Process value drift rate (i.e. leakage) (units/s)
iMax		Process value maximum
iMin		Process value minimum
iScan		Last scan time (us)

iRand_xL	Upper and lower random number limits - 0 = no random number



------------------------------------------------------------------------------*)

(* always calculate random number for use *)
Simulation_Random_Number_0 (LowerLimit := iRand_LL,
                            UpperLimit := iRand_UL,
                            RandomNumber =&gt; Rand_Num);

IF NOT iOvrPV THEN
	delta := (DINT_TO_REAL (IN := iScan) / 1000.0) *	(* Get scan time in s *)
		(SEL (G := iActv, IN0 := 0.0, IN1 := iRate) + iDrft);

	dPV := LIMIT (
		MN := iMin,
		IN := dPV + delta,
		MX := iMax
		);
END_IF;

IF iFrzVal THEN
	oPVEng := dPV;
ELSE
	oPVEng := dPV + Rand_Num;
END_IF;

(* calculate raw value for AI mapping block AS A % *)
RawMax := 100.0;
RawMin := 0.0;
oPVPer := RawMin + (oPVEng - iEngMin)*(RawMax - RawMin)/(iEngMax - iEngMin);
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="Simulation_Random_Number" version="0.05" dateTime="dt#2024-02-12-10:19:02">
