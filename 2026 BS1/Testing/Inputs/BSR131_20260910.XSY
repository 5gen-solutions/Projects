	<FBSource nameOfFBType="AlmIL_BF" version="1.42" dateTime="dt#2024-02-12-10:19:14">
		<comment>Alarm Interlock Brownfields</comment>
		<attribute name="TypeCodeCheckSumString" value="56CF"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="062F"></attribute>
		<inputParameters>
			<variables name="iFlt" typeName="EBOOL">
				<comment>The fault signal, which turns off Healthy output (after delay timer has elapsed).   </comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iHMIEnAlm" typeName="EBOOL">
				<comment>Enable generation of HMI Alarm</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iFltDlyTm" typeName="TIME">
				<comment>Duration fault signal must be off before turning off Healthy output</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="iAlmAck" typeName="EBOOL">
				<comment>HMI Alarm Acknowledge</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iSysFlt" typeName="EBOOL">
				<comment>System fault (ie: bad quality of fault signal)</comment>
