					<textBox width="110" height="4">***************************************************************************************************************************************************************************************************************************************************************************************************************************************
UPS Analogue Values Mapping
****************************************************************************************************************************************************************************************************************************************************************************************************************************************<objPosition posX="0" posY="3"></objPosition>
					</textBox>
				</networkFBD>
			</FBDSource>
		</FBProgram>
		<FBProgram name="UPSStatus">
			<STSource>(* 
Decoding UPS status. It is the sum of the following 2-exponent values
1 - 	UPS_SB_BYPASS_MODE (The Bypass is presently engaged on the UPS)
2 - 	UPS_SB_SHUTDOWN (The entire UPS has shutdown as commanded)
4 - 	UPS_SB_OUTPUT_ACT (Normal State, the output is on)
8 - 	UPS_SB_BACKUP_MODE (The UPS is drawing power from the batteries)
16 - 	UPS_SB_BATTERY_LOW (The remaining battery run-time is low)
32 - 	UPS_SB_OVER_TEMP (A temperature is out of tolerance)
64 - 	UPS_SB_TEST_ACT (A test is in progress)
128 - 	UPS_SB_INPUT_HIGH (An input condition is out of tolerance r)
256 - 	UPS_SB_OUTPUT_HIGH (The output load exceeds the UPS output capacity)
512 - 	UPS_SB_INVERTER_FAILURE (Inverter error)
1024 - 	UPS_SB_BATTERY_BAD (One or more batteries have been determined to require replacement)
2048 - 	UPS_SB_ECO_MODE (eco - bypass)
4096 - 	UPS_SB_INVERTER_WARN (eco - bypass)
8192 - 	UPS_SB_UPS_FAILED (A general fault in the UPS has been detected)
16384 - UPS_SB_COMM_LOST (A problem has been encountered in the communication to the UPS)
32768 - UPS_SB_DVG_ALARM (SiteManager/SiteMonitor)
*)



(* Determine what 2-exponents are used for a given UPS status value *)

UPSStsIDTmp := oUPSSts.StsID;

FOR i := 0 TO 15 DO
	IF MOD (UPSStsIDTmp, 2) = 1 THEN
		UPSStsArr[i] := TRUE;
	END_IF;

	UPSStsIDTmp := UPSStsIDTmp / 2;	
END_FOR;

UPSByp := UPSStsArr[0];
UPSSdn := UPSStsArr[1];
UPSOPAct := UPSStsArr[2];
UPSBatAct := UPSStsArr[3];
UPSBatTmLo := UPSStsArr[4];
UPSTmpFlt := UPSStsArr[5];
UPSTstAct := UPSStsArr[6];
UPSCondFlt := UPSStsArr[7];
UPSOPHi := UPSStsArr[8];
UPSInverterErr := UPSStsArr[9];
UPSBatFlt := UPSStsArr[10];
UPSEcoMode := UPSStsArr[11];
UPSInverterWrn := UPSStsArr[12];
UPSFlt := UPSStsArr[13];
UPSComFlt := UPSStsArr[14];
UPSDVGAlm := UPSStsArr[15];

FOR i := 0 TO 15 DO
	UPSStsArr[i] := FALSE;	
END_FOR;



(* Create a string of the UPS status for PLC display and a status ID for HMI to decode and display *)

IF NOT oDatOK THEN
	oUPSStsTxt := 'Data invalid, no UPS status to show';
ELSE
	oUPSStsTxt := '';

	IF oUPSSts.StsID = 4 THEN
   		oUPSStsTxt := 'UPS Output On &amp; Healthy';
	ELSIF oUPSSts.StsID = 0 THEN
		oUPSStsTxt := 'System Off';
	ELSE
		IF UPSByp THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Bypass Active, ');
		END_IF;
		
		IF UPSSdn THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'UPS Shutdown, ');
		END_IF;
		
		IF NOT UPSOPAct THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Output Inactive, ');
		END_IF;
		
		IF UPSBatAct THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'UPS Drawing from Batteries, ');
		END_IF;
		
		IF UPSBatTmLo THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Remaining Battery Runtime Low, ');
		END_IF;
		
		IF UPSTmpFlt THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Temperature Out of Tolerance, ');
		END_IF;
		
		IF UPSTstAct THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Test in Progress, ');
		END_IF;
		
		IF UPSCondFlt THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Input Condition Out of Tolerance, ');
		END_IF;
		
		IF UPSOPHi THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Output Load Exceeds Capacity, ');
		END_IF;
		
		IF UPSInverterErr THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Inverter Error, ');
		END_IF;
		
		IF UPSBatFlt THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Battery Replacement Required, ');
		END_IF;
		
		IF UPSEcoMode THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Eco Mode Active, ');
		END_IF;
		
		IF UPSInverterWrn THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Inverter Warning, ');
		END_IF;
		
		IF UPSFlt THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'UPS General Fault, ');
		END_IF;
		
		IF UPSComFlt THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'UPS Comms Fault, ');
		END_IF;
		
		IF UPSDVGAlm THEN
	   		oUPSStsTxt := CONCAT_STR(oUPSStsTxt, 'Diverter Fault, ');
		END_IF;

		IF oUPSStsTxt &lt;&gt; '' THEN
	   		oUPSStsTxt := REPLACE_INT(oUPSStsTxt,'', 2, LEN_INT(oUPSStsTxt)-1);
		END_IF;
		
	END_IF;
END_IF;
</STSource>
		</FBProgram>
		<FBProgram name="UPSAlarm">
			<STSource>(* Each alarm is an unsigned 16 bit value with 1 = alarm active and 0 = alarm not active *)



(* Create a string of the alarms for PLC display and an alarm ID for HMI to decode and display *)

IF NOT oDatOK THEN
	oUPSAlmTxt := 'Data invalid, no UPS alarm to show';
	oUPSSts.AlmID1 := 0;
	oUPSSts.AlmID2 := 0;
ELSE
	oUPSAlmTxt := '';

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[15]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Battery Bad, ');
		oUPSSts.AlmID1.0 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[16]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'On Battery, ');
		oUPSSts.AlmID1.1 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[17]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Battery Low, ');
		oUPSSts.AlmID1.2 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[18]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Battery Depleted, ');
		oUPSSts.AlmID1.3 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[19]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Over Temperature, ');
		oUPSSts.AlmID1.4 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[20]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Input Bad, ');
		oUPSSts.AlmID1.5 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[21]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Output Bad, ');
		oUPSSts.AlmID1.6 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[22]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Output Overload, ');
		oUPSSts.AlmID1.7 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[23]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'On Bypass, ');
		oUPSSts.AlmID1.8 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[24]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Bypass Bad, ');
		oUPSSts.AlmID1.9 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[25]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Output Off As Requested, ');
		oUPSSts.AlmID1.10 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[26]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'UPS Off As Requested, ');
		oUPSSts.AlmID1.11 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[27]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Charger Failed, ');
		oUPSSts.AlmID1.12 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[28]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'UPS Output Off, ');
		oUPSSts.AlmID1.13 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[29]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'UPS System Off, ');
		oUPSSts.AlmID1.14 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[30]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Fan Failure, ');
		oUPSSts.AlmID1.15 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[31]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Fuse Failure, ');
		oUPSSts.AlmID2.0 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[32]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'General Fault, ');
		oUPSSts.AlmID2.1 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[33]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Diagnose Test Failed, ');
		oUPSSts.AlmID2.2 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[34]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Communication Lost, ');
		oUPSSts.AlmID2.3 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[35]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Awaiting Power, ');
		oUPSSts.AlmID2.4 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[36]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Shutdown Pending, ');
		oUPSSts.AlmID2.5 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[37]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Shutdown Imminent, ');
		oUPSSts.AlmID2.6 := TRUE;
	END_IF;

	IF WORD_TO_UINT(iDatDDT.UPSDatIn[38]) = 1 THEN
		oUPSAlmTxt := CONCAT_STR(oUPSAlmTxt, 'Test in Progress, ');
		oUPSSts.AlmID2.7 := TRUE;
	END_IF;

	IF oUPSAlmTxt &lt;&gt; '' THEN
  		oUPSAlmTxt := REPLACE_INT(oUPSAlmTxt,'', 2, LEN_INT(oUPSAlmTxt)-1);
	ELSIF oUPSAlmTxt = '' AND oUPSFlt THEN
		oUPSAlmTxt := 'Unknown Fault, See Unit';
	ELSE
		oUPSAlmTxt := 'No UPS Alarms Active';
	END_IF;

END_IF;





