			<variables name="S1" typeName="INT"></variables>
			<variables name="S2" typeName="INT"></variables>
			<variables name="Seconds" typeName="INT"></variables>
			<variables name="H1" typeName="INT"></variables>
			<variables name="H2" typeName="INT"></variables>
			<variables name="Hours" typeName="INT"></variables>
			<variables name="M1" typeName="INT"></variables>
			<variables name="M2" typeName="INT"></variables>
			<variables name="Minutes" typeName="INT"></variables>
			<variables name="Mo1" typeName="INT"></variables>
			<variables name="Mo2" typeName="INT"></variables>
			<variables name="Month" typeName="INT"></variables>
			<variables name="D1" typeName="INT"></variables>
			<variables name="D2" typeName="INT"></variables>
			<variables name="Day" typeName="INT"></variables>
			<variables name="A2" typeName="INT"></variables>
			<variables name="A31" typeName="INT"></variables>
			<variables name="A32" typeName="INT"></variables>
			<variables name="A41" typeName="INT"></variables>
			<variables name="A42" typeName="INT"></variables>
			<variables name="DayOfWeekStr" typeName="STRING"></variables>
			<variables name="SwapArray" typeName="ARRAY[1..4] OF INT"></variables>
			<variables name="B2" typeName="INT"></variables>
			<variables name="B31" typeName="INT"></variables>
			<variables name="B32" typeName="INT"></variables>
			<variables name="B41" typeName="INT"></variables>
			<variables name="B42" typeName="INT"></variables>
			<variables name="B51" typeName="INT"></variables>
			<variables name="B52" typeName="INT"></variables>
			<variables name="B61" typeName="INT"></variables>
			<variables name="B62" typeName="INT"></variables>
			<variables name="B71" typeName="INT"></variables>
			<variables name="B72" typeName="INT"></variables>
			<variables name="B73" typeName="INT"></variables>
			<variables name="B74" typeName="INT"></variables>
			<variables name="AddrRef4" typeName="INT">
				<comment>Address Reference for UTC Hours Update</comment>
			</variables>
			<variables name="UTCHours" typeName="INT">
				<comment>UTC Offset Hours</comment>
			</variables>
			<variables name="UTCMins" typeName="INT">
				<comment>UTC Offset Minutes</comment>
			</variables>
			<variables name="AddrRef3" typeName="INT">
				<comment>Address Reference for UTC Minutes Update</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="SetClock">
			<STSource>(* 
Define a time block going to the input "AddrReference".
Define it as an Array of 7 int.


The Format of the Time block set by the Scada has to be :
 AddrReference(1) 	: Day of the Week (1=Monday, 2=Tuesday,3=Wednesday,4=Thursday,5=Friday,6=Saturday,7=Sunday)
 AddrReference(2)	: Seconds
 AddrReference(3) 	: Minutes
 AddrReference(4)	: Hours 
 AddrReference(5)	: Day
 AddrReference(6)	: Month
 AddrReference(7)	: Year

 *)


(* The M580 processor have changed the time format to be stored in UTC.
   For compatibility, use the UTCOffset setting if required such that 
   all values can be set as real time values, however updates to internal
   PLC clock will be in UTC format.
*)

(* Convert minute offset to hours and minutes *)
DIVMOD (IN1 := UTCOffset,IN2 := 60,
        DV =&gt; UTCHours, MD =&gt; UTCMins);

AddrRef4 := AddrReference[4] - UTCHours;
IF AddrRef4 &lt; 0 THEN
	AddrRef4 := 24-UTCHours+AddrReference[4];
END_IF;
IF AddrRef4 &gt; 23 THEN
	AddrRef4 := AddrRef4 - 24;
END_IF;
AddrRef3 := AddrReference[3] - UTCMins;
IF AddrRef3 &lt; 0 THEN
	AddrRef3 := 60-UTCMins+AddrReference[3];
END_IF;
IF AddrRef3 &gt; 59 THEN
	AddrRef3 := AddrRef3 - 60;
END_IF;

IF SetClock THEN

	%S50 := 1; 			(* To allow to change the Time System Words*)
	
	A2 := AddrReference[2]/10;
	%SW50 := A2* 4096 + (AddrReference[2]-A2*10)*256;(* Set the seconds on the MSB*)
	
	A31 := AddrRef4/10;
	A32 := AddrRef4 - A31*10;
	A41 := AddrRef3/10;
	A42 := AddrRef3 - A41*10;
	%SW51 := A31*4096 + A32*256 + A41*16 + A42; (* Set the Hours on the MSB and the Minutes on the LSB*)	
						
	SetSWDone := 1;			(* Bool to show that the SW have been assigned and still locked*)
ELSE
	%S50 := 0;			(* Update the clock with the new SW and then lock the SW *)
	SetSWDone:=0;			(* The SW are updated*)
END_IF ;
</STSource>
		</FBProgram>
		<FBProgram name="DispatchDatas">
			<FBDSource nbRows="57" nbColumns="15">
				<networkFBD>
					<FFBBlock instanceName=".2" typeName="MOVE" additionnalPinNumber="0" enEnO="false" width="7" height="5">
						<objPosition posX="20" posY="3"></objPosition>
