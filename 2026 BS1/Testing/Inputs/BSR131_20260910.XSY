			<variables name="R_Trig_Stt" typeName="R_TRIG">
				<comment>Rising Edge Trigger Instance for Start Pushbutton</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="TstDet">
			<FBDSource nbRows="57" nbColumns="15">
				<networkFBD>
					<FFBBlock instanceName="R_Trig_Stt" typeName="R_TRIG" additionnalPinNumber="0" enEnO="false" width="7" height="5">
