Date Changed:		18/03/2020
Change Comments:	Initial Release
Revision:		1.00

==========================================================================================================================================
Copyright Rio TInto Pty Ltd, 2020
==========================================================================================================================================
    <objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="70" height="2">Map out the module diagnostic bits for HMI display.
    <objPosition posX="0" posY="136"></objPosition>
					</textBox>
				</networkFBD>
			</FBDSource>
		</FBProgram>
	</FBSource>
