			<variables name="iOvrdOffCmd" typeName="EBOOL">
				<comment>Override Off Command  (Turns off Process Control)</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iOvrdTm" typeName="TIME">
