							<inputVariable invertedPin="false" formalParameter="IN2" effectiveParameter="iTstEqpMode"></inputVariable>
							<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
							<outputVariable invertedPin="false" formalParameter="OUT"></outputVariable>
						</descriptionFFB>
					</FFBBlock>
					<FFBBlock instanceName=".36" typeName="OR" additionnalPinNumber="0" enEnO="false" width="7" height="6">
