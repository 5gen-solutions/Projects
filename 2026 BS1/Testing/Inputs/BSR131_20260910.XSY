			</variables>
		</structure>
	</DDTSource>
	<FBSource nameOfFBType="TotaliserPulse" version="1.00" dateTime="dt#2024-02-12-10:19:03">
		<comment>Totalise a Totaliser Pulse Input</comment>
		<attribute name="TypeCodeCheckSumString" value="91D0"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="AE68"></attribute>
		<inputParameters>
			<variables name="iOK" typeName="EBOOL">
				<comment>Pulse Input Healthy</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iPls" typeName="EBOOL">
				<comment>Pulse Input</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="iPlsVal" typeName="REAL">
				<comment>Quantity of Each Pulse (u)</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iRst" typeName="EBOOL">
				<comment>Totaliser Reset Request</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="iCfg" typeName="INT">
				<comment>Pulse Increment Tigger (0: Rising &amp; Falling Edge; 1: Rising Edge; 2: Falling Edge)</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iShfPls" typeName="EBOOL">
