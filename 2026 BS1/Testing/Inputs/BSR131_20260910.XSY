			</variables>
			<variables name="PrvWkTot" typeName="UDINT">
				<comment>Previous Week Totaliser</comment>
			</variables>
			<variables name="MthTot" typeName="UDINT">
				<comment>This Month Totaliser</comment>
			</variables>
			<variables name="PrvMthTot" typeName="UDINT">
				<comment>Previous Month Totaliser</comment>
			</variables>
			<variables name="Tot" typeName="UDINT">
				<comment>Totaliser (u)</comment>
			</variables>
		</structure>
	</DDTSource>
	<FBSource nameOfFBType="TstDet" version="2.23" dateTime="dt#2019-08-27-16:04:16">
		<comment>Test Detect</comment>
		<attribute name="TypeProtectionLevel" value="2#0000_0000"></attribute>
		<attribute name="TypeCodeCheckSumString" value="4D20"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="6AC4"></attribute>
