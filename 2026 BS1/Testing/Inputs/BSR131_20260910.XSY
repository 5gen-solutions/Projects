	<FBSource nameOfFBType="ACS880Out" version="2.00" dateTime="dt#2026-03-20-11:04:58">
		<comment>ABB ACS880 VSD Drive Interface Out (v2.00)</comment>
		<attribute name="TypeProtectionLevel" value="2#0000_0000"></attribute>
		<attribute name="TypeCodeCheckSumString" value="DD35"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="A2F5"></attribute>
		<inputParameters>
			<variables name="iRst" typeName="EBOOL">
				<comment>Reset Request</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="iExtCtl" typeName="EBOOL">
				<comment>Run Forward &amp; Reverse Requests Hardwired to ACS880</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="iSpdFac" typeName="REAL">
				<comment>Speed Scaling Factor</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="iSpdSP" typeName="REAL">
				<comment>Speed Setpoint (%)</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="iFwdStt" typeName="EBOOL">
				<comment>Run Forward Request</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iRevStt" typeName="EBOOL">
				<comment>Run Reverse Request</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="ioExtCfg" typeName="ACS880CfgDDT">
				<comment>Status Data for Sharing Between Input &amp; Output Object</comment>
				<attribute name="PositionPin" value="8"></attribute>
				<instanceElementDesc name="STOOK">
					<comment>Safe Torque Off (STO) Healthy</comment>
				</instanceElementDesc>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="oDatDDT" typeName="ACS880RawOutDDT">
				<comment>DDT of Actual Signal Data to be Written to Unit</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="SpdSP" typeName="REAL">
				<comment>Drive Conditioned Speed Setpoint</comment>
			</variables>
			<variables name="RunReq" typeName="EBOOL">
				<comment>Drive Conditioned Run Request</comment>
			</variables>
			<variables name="RunDir" typeName="REAL">
				<comment>Drive Conditioned Run Request Direction (1=Fwd; -1=Rev)</comment>
			</variables>
			<variables name="SpeedRef" typeName="INT">
				<comment>Drive Speed Setpoint Raw</comment>
			</variables>
			<variables name="TOF_RstHi" typeName="TOF">
				<comment>Drive Fault Reset Pulse High Timer</comment>
			</variables>
			<variables name="TOF_RstLo" typeName="TOF">
				<comment>Drive Fault Reset Pulse Low Timer</comment>
			</variables>
			<variables name="FltRst" typeName="EBOOL">
				<comment>Drive Fault Reset Request</comment>
			</variables>
			<variables name="SpdFactor" typeName="REAL">
				<comment>Speed Scaling Factor for SP%</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="ACS880Out">
			<STSource>(*
***********************************************************************************************
   FUNCTION BLOCK - ACS880Out
***********************************************************************************************
  Description:      ABB ACS880 VSD Interface Out Object
  Date Changed:	    20/03/2026
  Change Comments:  Removed Free1 from ACS880RawOutDDT to suit I/O Scanning mode change from Legacy to Enhanced and updated comments to reflect new FEIP module
  Revision:    	    2.00

***********************************************************************************************
  Copyright Rio Tinto Pty Ltd, 2026.
***********************************************************************************************

***********************************************************************************************
Description:
***********************************************************************************************
The object carries out the control mapping of data to the ACS880 VVVF drive over Ethernet/IP.
The input map is based on ESD profile 'ABB Drives 102/152 Set Speed and Set Torque plus Drive Parameters',
with the first 2 words fixed and the remaining words set within the FEIP-21 module. The EDS
file required for this interface is provided by ABB with file name
"FEIP21_filerev1_1.EDS".

The data map is as follows:
  WORDS           DESCRIPTION
- CW            - Drive Control (Fixed)
- Speed_Ref     - Speed Setpoint (Fixed)
- Torque_Ref    - Unused Torque Setpoint (Fixed)
- DATA_IN_1-10  - Unused

The DFB can be used in three possible configurations:
 + Full Ethernet Control	- The Run Forward, Run Reverse, Speed Setpoint and Reset
 				  requests are all communicated via Ethernet/IP.
 + Mixed Control		- The Run Forward &amp; Run Reverse requests are via hardwired
 				  control and, the Speed Setpoint and Reset requests are
				  communicated via Ethernet/IP.
 + Reset Control		- The Reset request is communicated via Ethernet/IP.

For Full Control, the Run Forward/Reverse (iRunFwd/iRunRev) pins are used to run the drive
in the forward/reverse directions. The Speed Setpoint (iSpdSP) pin is used to set the drive
speed. The External Control (iExtCtl) pin must be set to FALSE.

For Mixed Control, the Run Forward/Reverse (iRunFwd/iRunRev) pins are not used. The drive
forward/reverse requests are via hardwired inputs to the drive. The Speed Setpoint (iSpdSP)
pin is used to set the drive speed. The External Control (iExtCtl) pin must be set to TRUE.

For Reset Control, the Run Forward/Reverse (iRunFwd/iRunRev), Speed Setpoint (iSpdSP) and
External Control (iExtCtl) pins are not used. These pins should all be set to FALSE.

The Speed Setpoint (iSpdSP) must be supplied as an absolute value; i.e. the allowable range
for the speed is 0-100%. The direction of the drive is always determined by the Run
Forward/Reverse requests.

The Reset Request (iRstReq) is used to reset drive faults.

This DFB is to be used in conjunction with the ACS880In block. The ACS880In block is used to
send drive parameters to the drive.

***********************************************************************************************

***********************************************************************************************
Revision History:
***********************************************************************************************
2.00	BCY	20/03/2026	Removed Free1 from ACS880RawOutDDT to suit I/O Scanning mode change from Legacy to Enhanced and updated comments to reflect new FEIP module
1.00	NJA	25/06/2020	Initial Release

***********************************************************************************************


*)

(* SPEED SCALING FACTOR *)
(* To allow transparency when running a drive lower than speed scaling parameter but this
is still to be set at a higher value, say 100%, provision a speed scaling factor into
the block *)
IF iSpdFac &lt;= 0.0 THEN
	SpdFactor := 1.0;
ELSE
	SpdFactor := iSpdFac;
END_IF;


(* Ensure the speed setpoint is in a valid range *)
IF iSpdSP &lt; 0.0 THEN
	SpdSP := 0.0;
ELSIF 100.0 &lt; iSpdSP THEN
	SpdSP := 100.0;
ELSE
	SpdSP := iSpdSP;
END_IF;



(* Based on the RunFwd/RunRev signals set the speed direction and the drive run command *)
IF iExtCtl AND ioExtCfg.OK THEN
	RunReq := FALSE;
	RunDir := 1.0;
ELSIF iFwdStt AND NOT iRevStt AND ioExtCfg.OK THEN
	RunReq := TRUE;
	RunDir := 1.0;
ELSIF NOT iFwdStt AND iRevStt AND ioExtCfg.OK THEN
	RunReq := TRUE;
	RunDir := -1.0;
ELSE
	RunReq := FALSE;
	RunDir := 0.0;
END_IF;



(* Set the drive speed reference *)
(* The drive direction is controlled based on the pos/neg status of the speed reference. A positive speed setpoint corresponds to forward. *)
(* Ensure there is no divide by zero *)
IF (ioExtCfg.SpdFac &gt; 0.0) THEN
	SpeedRef :=  REAL_TO_INT(SpdFactor * RunDir * (SpdSP * (ioExtCfg.MaxSpd - ioExtCfg.MinSpd) / 100.0 + ioExtCfg.MinSpd) * 20000.0 / ioExtCfg.SpdFac);
ELSE
	SpeedRef := 0;
END_IF;



(* Based on the fault reset being a pulse generated external to be block, latch up the reset for a minimum of 500ms and then pulse the reset on/off every 500ms. *)
(* Inhibit the reset function if the STO is unhealthy as it causes the drive to attempt to reset and to behave badly. *)
(* When communications to the drive are re-established, automatically reset the drive to prevent a fault alarm. *)
TOF_RstHi(	IN := ((iRst AND ioExtCfg.STOOK) OR ioExtCfg.ComRst) AND NOT (TOF_RstHi.Q OR TOF_RstLo.Q),
		PT := t#500ms,
		Q  =&gt; FltRst);
TOF_RstLo(	IN := TOF_RstHi.Q,
		PT := t#500ms);


(* Write outputs to the drive *)
oDatDDT.CW.0		:= ioExtCfg.DrvPwrOn;			(* Proceed to Ready to Operate (Off 1 healthy - Stop by deceleration ramp profile) *)
oDatDDT.CW.1		:= TRUE;				(* Off 2 healthy - Coast Stop *)
oDatDDT.CW.2		:= TRUE;				(* Off 3 healthy - Fast Stop *)
oDatDDT.CW.3		:= RunReq;				(* Run *)
oDatDDT.CW.4		:= RunReq;				(* Enable Ramp Generator *)
oDatDDT.CW.5		:= RunReq;				(* Enable Ramp Accelerator *)
oDatDDT.CW.6		:= RunReq;				(* Proceed to Operating *)
oDatDDT.CW.7		:= FltRst;				(* Drive Fault Reset *)
oDatDDT.CW.8		:= FALSE;				(* Reserved *)
oDatDDT.CW.9		:= FALSE;				(* Reserved *)
oDatDDT.CW.10		:= TRUE;				(* Remote Fieldbus Enable Command *)
oDatDDT.CW.11		:= FALSE;				(* Select Main Control Location (FALSE=EXT1,TRUE=EXT2) *)
oDatDDT.CW.12		:= FALSE;				(* Reserved *)
oDatDDT.CW.13		:= FALSE;				(* Reserved *)
oDatDDT.CW.14		:= FALSE;				(* Reserved *)
oDatDDT.CW.15		:= FALSE;				(* Reserved *)

oDatDDT.Speed_Ref	:= INT_TO_WORD(SpeedRef);		(* Speed Setpoint *)
oDatDDT.Torque_Ref	:= 0;					(* Torque Setpoint (Not Used) *)

oDatDDT.DATA_OUT_1	:= 0;					(* Not Used *)
oDatDDT.DATA_OUT_2	:= 0;					(* Not Used *)
oDatDDT.DATA_OUT_3	:= 0;					(* Not Used *)
oDatDDT.DATA_OUT_4	:= 0;					(* Not Used *)
oDatDDT.DATA_OUT_5	:= 0;					(* Not Used *)
oDatDDT.DATA_OUT_6	:= 0;					(* Not Used *)
oDatDDT.DATA_OUT_7	:= 0;					(* Not Used *)
oDatDDT.DATA_OUT_8	:= 0;					(* Not Used *)
oDatDDT.DATA_OUT_9	:= 0;					(* Not Used *)
oDatDDT.DATA_OUT_10	:= 0;					(* Not Used *)
</STSource>
		</FBProgram>
	</FBSource>
	<DDTSource DDTName="ACS880RawOutDDT" version="0.08" dateTime="dt#2026-02-10-08:59:47">
