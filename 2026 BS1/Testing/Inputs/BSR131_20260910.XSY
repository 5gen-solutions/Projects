	<FBSource nameOfFBType="DateTimeLog" version="0.06" dateTime="dt#2019-12-18-07:54:26">
		<attribute name="TypeCodeCheckSumString" value="50D6"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="035A"></attribute>
		<inputParameters>
			<variables name="iPls" typeName="EBOOL">
				<comment>Add Current Time to Array</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="iClr" typeName="EBOOL">
				<comment>Clear Array Data</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="ioArr" typeName="ANY_ARRAY_INT">
				<comment>Date &amp; Time Array of Format "ARRAY[0..(6*x-1)] OF INT"</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</inOutParameters>
		<privateLocalVariables>
			<variables name="PlsLstScn" typeName="EBOOL"></variables>
			<variables name="i" typeName="INT"></variables>
			<variables name="ArrLen" typeName="INT"></variables>
			<variables name="TempDT" typeName="DT"></variables>
			<variables name="TempDT_INT" typeName="ARRAY[0..3] OF INT"></variables>
			<variables name="DTLen" typeName="INT"></variables>
		</privateLocalVariables>
		<FBProgram name="DateTimeLog">
			<STSource>(* DateTimeLog

Date Time Logging
On the rising edge of iPls, increment all items in the DateTime
array ioArr down by six and insert the current date and time
into the first six elements.

Array ioArr must be an array of at least 6 elements long. The
length of ioArr should be a multiple of 6. Declare the array in
the form:
ARRAY[0..(6*x-1)] OF INT

WARNING: THIS IS A TESTING DFB ONLY! IT HAS NOT BEEN TESTED!


Revision:
20191218 07:54 - NJA - Creation


*)


(* Check the DFB array size *)
ArrLen := LENGTH_ARINT(ioArr);
(* Determine the number of dates we can get in the array *)
DTLen := ArrLen / 6;

(* Check we are not doing a first scan or a warm start *)
IF NOT %S21 AND %SW10.0 AND (DTLen &gt;= 1) THEN

	
	(* If we have a rising edge on iPls, update the array *)
	IF iPls AND NOT PlsLstScn THEN
		(* Shift all elements down by 1 *)
		FOR i:=(DTLen-1) TO 1 BY -1 DO
			ioArr[(i*6)+0] := ioArr[((i-1)*6)+0];	(* Seconds *)
			ioArr[(i*6)+1] := ioArr[((i-1)*6)+1];	(* Min *)
			ioArr[(i*6)+2] := ioArr[((i-1)*6)+2];	(* Hour *)
			ioArr[(i*6)+3] := ioArr[((i-1)*6)+3];	(* Day *)
			ioArr[(i*6)+4] := ioArr[((i-1)*6)+4];	(* Month *)
			ioArr[(i*6)+5] := ioArr[((i-1)*6)+5];	(* Year *)
		END_FOR;
		(* Insert current time into first element of array *)
		RRTC_DT(TempDT);
		TempDT_INT := DT_TO_ARINT(TempDT);
		ioArr[0] := BCD_TO_INT(TempDT_INT[0] /   16#0100);	(* Seconds *)
		ioArr[1] := BCD_TO_INT(TempDT_INT[1] AND 16#00FF);	(* Min *)
		ioArr[2] := BCD_TO_INT(TempDT_INT[1] /   16#0100);	(* Hour *)
		ioArr[3] := BCD_TO_INT(TempDT_INT[2] AND 16#00FF);	(* Day *)
		ioArr[4] := BCD_TO_INT(TempDT_INT[2] /   16#0100);	(* Month *)
		ioArr[5] := BCD_TO_INT(TempDT_INT[3]);			(* Year *)
	END_IF;
	PlsLstScn := iPls;
	

	(* Clear the array if requested *)
	IF iClr THEN
		FOR i:=0 TO (DTLen-1) BY 1 DO
			ioArr[(i*6)+0] := 0;	(* Seconds *)
			ioArr[(i*6)+1] := 0;	(* Min *)
			ioArr[(i*6)+2] := 0;	(* Hour *)
			ioArr[(i*6)+3] := 0;	(* Day *)
			ioArr[(i*6)+4] := 0;	(* Month *)
			ioArr[(i*6)+5] := 0;	(* Year *)
		END_FOR;
	END_IF;
END_IF;
</STSource>
		</FBProgram>
	</FBSource>
