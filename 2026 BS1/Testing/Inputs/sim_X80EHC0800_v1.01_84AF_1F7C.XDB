				<comment>Fast Ramp Enabled</comment>
				<attribute name="PositionPin" value="18"></attribute>
			</variables>
			<variables name="iSpdFac" typeName="REAL">
				<comment>Speed Factor (+ - %)</comment>
				<attribute name="PositionPin" value="19"></attribute>
			</variables>
			<variables name="iSpdOvrSP" typeName="REAL">
				<comment>Simulation Speed Override (%)</comment>
				<attribute name="PositionPin" value="20"></attribute>
			</variables>
			<variables name="iSpdOvrEn" typeName="EBOOL">
				<comment>Sim Speed Override Enable Pin</comment>
				<attribute name="PositionPin" value="21"></attribute>
			</variables>
			<variables name="iEng" typeName="BOOL">
				<comment>Engineering Units (0 = m/s, 1 = rpm)</comment>
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
			<variables name="iCustomMode" typeName="INT">
				<comment>Default: 0 (Ch0 = Period counter, Ch1 = Modulo Counting). Configure &gt;0 for different modes outsideblock or in sim code</comment>
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
			<variables name="iSpdSP" typeName="REAL">
