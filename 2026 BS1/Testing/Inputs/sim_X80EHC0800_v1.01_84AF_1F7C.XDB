				<comment>Ch1 Input B</comment>
				<attribute name="PositionPin" value="28"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="oDatDDT" typeName="T_M_CPT_STD_IN_8">
				<comment>Write to Dat DDT</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="oSpd" typeName="REAL">
				<comment>Calculated Speed (m/s)</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="pi" typeName="REAL">
				<comment>pi- constant</comment>
			</variables>
			<variables name="tabcount" typeName="REAL">
				<comment>number of speed tabs</comment>
			</variables>
			<variables name="RAMP_0" typeName="RAMP"></variables>
			<variables name="ReqSpd" typeName="REAL">
				<comment>Required Speed SP</comment>
			</variables>
			<variables name="Spd100" typeName="REAL">
				<comment>Speed at 100% SP m/s or rpm</comment>
			</variables>
			<variables name="Frequency" typeName="REAL">
				<comment>Frequency Output</comment>
			</variables>
			<variables name="UpdateTm" typeName="REAL">
				<comment>Period output</comment>
			</variables>
			<variables name="DisPerTab" typeName="REAL">
				<comment>Distance Per Tab</comment>
			</variables>
			<variables name="ScanTotal" typeName="UDINT"></variables>
			<variables name="SpdCalcOK" typeName="EBOOL"></variables>
			<variables name="PulseOut" typeName="EBOOL"></variables>
			<variables name="PulseOnTm" typeName="UDINT"></variables>
			<variables name="PulseOutTime" typeName="UDINT"></variables>
			<variables name="PulseMod" typeName="UDINT"></variables>
			<variables name="PulseCount" typeName="UDINT"></variables>
			<variables name="PulseUpdate" typeName="UDINT"></variables>
			<variables name="Circ" typeName="REAL">
				<comment>Circumference </comment>
			</variables>
			<variables name="Ramp_Para" typeName="Para_RAMP"></variables>
			<variables name="To_ZQ01Cnt" typeName="UDINT"></variables>
			<variables name="To_PulseDI" typeName="EBOOL"></variables>
			<variables name="To_USSTm" typeName="UDINT"></variables>
			<variables name="To_USSFrq" typeName="UDINT"></variables>
			<variables name="SIM_Random_Number_0" typeName="SIM_Random_Number"></variables>
			<variables name="Rand_Real_Val" typeName="REAL">
				<comment>Random Real Value</comment>
			</variables>
			<variables name="TmBetPls" typeName="REAL"></variables>
			<variables name="TmBetPlsUDINT" typeName="UDINT"></variables>
			<variables name="FrqSP" typeName="REAL"></variables>
			<variables name="FrqSP_UDINT" typeName="UDINT"></variables>
			<variables name="PlsOn" typeName="EBOOL"></variables>
			<variables name="PlsCnt" typeName="UDINT"></variables>
			<variables name="Period" typeName="TIME"></variables>
			<variables name="TON_Period" typeName="TON"></variables>
			<variables name="PeriodTimerReached" typeName="EBOOL"></variables>
			<variables name="PlsOnTrig" typeName="EBOOL"></variables>
			<variables name="PlsCntTrig" typeName="EBOOL"></variables>
			<variables name="R_TRIG_Period" typeName="R_TRIG"></variables>
			<variables name="TP_PulseGen" typeName="TP"></variables>
			<variables name="R_TRIG_PlsOn" typeName="R_TRIG"></variables>
		</privateLocalVariables>
		<FBProgram name="Sim_Speed">
			<STSource>(* Simulation DFB for X80_EHC0200In and X80_EHC0200Out High SPeed Counter Blocks
This Block simulates:
- DINT and UDINT inputs read back from the high speed counter block
- Fault Toggling
- Toggling Channel Inputs

01/05/2026 - BCY: Initial Release, adapted from WR Sim_X80EHC0200 block and modified to suit Frequency mode

*)

(* This section simulates speed for the high speed counter

THE CODE BELOW DIRECTLY WRITES TO iCustomMode = 0, 
WHERE Channel 0 is set as Frequency Measuring Mode
      Channel 1 is set as Modulo Loop Counting Mode.
 *)

IF iEnable THEN

	(* ===== Constants ===== *)

	pi := 3.14159265359;
	(* to disable DifFlt of DistCheck Block *)
	SIM_Random_Number_0 (LowerLimit := -1.0,
	                     UpperLimit := 1.0,
	                     RandomNumber =&gt; Rand_Real_Val); 



	tabcount := MAX (IN1 := 1.0 , IN2 := iPlsDia );  (* Protect Div 0 Err *)
	Ramp_Para.Inc_rate := iRampUpTm;
	Ramp_Para.Dec_rate := iRampDwnTm;

	IF iFstEn THEN 
		Ramp_Para.Dec_Rate := iRampFstTm;
	END_IF;

	(* ===== distance travelled per tab update ===== *)
	(* Protect Div 0 Err *)
	IF iDia = 0.0 THEN
		Circ := 1.0;
	ELSE
		Circ := pi*iDia;
	END_IF;
	DisPerTab := Circ/tabcount;


	(* ===== Speed Units ===== *)
	IF iEng THEN 
		Spd100 := iEngMax * Circ /60.0; (* rpm as m/s *)
	ELSE
		Spd100 := iEngMax;
	END_IF;

	(* ===== Speed Ramp ====== *)
	(* Speed Calc -&gt; update rate between tabs *)
	IF iSpdOvrEn then 
		ReqSpd := iSpdOvrSP *Spd100/100.0;	(* Speed Override *)
	ELSIF iRun THEN
		ReqSpd := iSpdSp *Spd100/100.0;
	ELSE 
		ReqSpd := 0.0;
	END_IF;

	RAMP_0 (RSP := ReqSpd,
	        PARA := Ramp_Para,
	        SP =&gt; oSpd);

	IF oSpd &gt;= 0.04 *Spd100 THEN 
		TmBetPls := ((DisPerTab/oSpd)*1000.0); (* millisec*)
		Frequency:= 1.0 / (DisPerTab/oSpd) + Rand_Real_Val; (* sec*)
		SpdCalcOK:= 1;
	ELSE
		TmBetPls := 1.0;
		UpdateTm :=  0.0;
		Frequency:= 0.0;
		SpdCalcOK := 0;
	END_IF;

	To_USSTm := REAL_TO_UDINT(UpdateTm);
	To_USSFrq := REAL_TO_UDINT(Frequency);
	TmBetPlsUDINT := REAL_TO_UDINT(TmBetPls);


	(* Distance counter *)

	(* accumulate scan time, reset when pulse detected *)

	IF SpdCalcOK THEN
		ScanTotal := ScanTotal + INT_TO_UDINT(iScnTm);
	ELSE
		ScanTotal := 0;
	END_IF;


		DIVMOD_UDINT (	IN1 	:= (ScanTotal),
				IN2 	:= TmBetPlsUDINT,
				DV 	=&gt; PulseUpdate,
				MD 	=&gt; PulseMod);


	PulseOut := 0;
	IF PulseUpdate &gt; 0 THEN
		PulseCount := PulseCount + PulseUpdate;
		PulseOut := 1;
		ScanTotal := PulseMod;
	END_IF;

	IF PulseCount &gt;= 9999 THEN (* rollover after 9999 to 0 *)
		PulseCount := PulseCount - 9999;
	END_IF;
	To_ZQ01Cnt := PulseCount; (* pulses counter to ehc output data *)

	(* USS Dig In Status - Assume tab is 10mm window *)
	IF SpdCalcOK THEN
		PulseOutTime := REAL_TO_UDINT(0.010 / oSpd * 1000.0);
		PulseOnTm := PulseOnTm + INT_TO_UDINT(iScnTm);
	END_IF;
	IF PulseOut THEN
		PulseOnTm := 0;
	END_IF;
	To_PulseDI := PulseOut OR (To_PulseDI AND PulseOnTm &lt;= PulseOutTime);

END_IF;
</STSource>
		</FBProgram>
		<FBProgram name="PulseSeqGen">
			<STSource>(*  This section generates step pulses at a settable frequency and counts the number of pulses

THE CODE BELOW DIRECTLY WRITES TO iCustomMode = 1.
WHERE Channel 0 is set as Frequency Measuring Mode
      Channel 1 is set as Modulo Loop Counting Mode.

 *)

IF iEnable THEN

	FrqSP := MAX (IN1 := 0.1 , IN2 := iFrqSP );  (* Protect Div 0 Err *)

	FrqSP_UDINT := REAL_TO_UDINT(FrqSP);

	(* Period in milliseconds *)
	Period := REAL_TO_TIME(1000.0 / FrqSP);

	TON_Period (IN:=(NOT PeriodTimerReached), PT:=Period, Q=&gt;PeriodTimerReached);

	R_TRIG_Period (CLK:=PeriodTimerReached, Q=&gt;PlsOnTrig);


	IF iPlsCntRst THEN
	    PlsCnt := 0;
	ELSIF PlsOnTrig THEN
	    PlsCnt := PlsCnt + 1;

	    IF PlsCnt &gt;= 9999 THEN (* rollover after 9999 to 0 *)
	        PlsCnt := PlsCnt - 9999;
	    END_IF;
	END_IF;

ELSE

	PlsCnt := 0;

END_IF;
</STSource>
		</FBProgram>
		<FBProgram name="ModChWrites">
			<STSource>(* Simulation DFB for X80_EHC0200In and X80_EHC0200Out High SPeed Counter Blocks
This Block simulates:
- DINT and UDINT inputs read back from the high speed counter block
- Fault Toggling
- Toggling Channel Inputs

AXY 09/02/2023	- initial release
AXY 08/05/2023	- Added Speed simulation to sim block (adapted from sim_speed)

 *)


(* 
This section of the Code takes values calculated from sim_speed section and outputs them to the correct
EHC0200 Channel for reading.

Channel Input Simulation, Always Write sim inputs to both Channels, 
DFB In block will decipher the type of function and filter out DINT/UDINT data read back *)

IF iEnable THEN

	CASE iCustomMode OF

	0:	(* The following is default settings to the BS1 project: 
		Ch0 = Frequency Measuring Mode (1)
		Ch1 = Modulo Loop Counting Mode (7) *)
		oDatDDT.CPT_CH_IN[0].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := 0); 
		oDatDDT.CPT_CH_IN[0].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP := To_USSFrq);

		oDatDDT.CPT_CH_IN[1].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := 0 );
		oDatDDT.CPT_CH_IN[1].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP :=  To_ZQ01Cnt);

		(* Channel A/B Input *)
		oDatDDT.CPT_CH_IN[0].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= To_PulseDI ) ;
		oDatDDT.CPT_CH_IN[0].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= 0) ;

		oDatDDT.CPT_CH_IN[1].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= To_PulseDI) ;
		oDatDDT.CPT_CH_IN[1].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= 0) ;

		(* Channel Set Valid *)
		oDatDDT.CPT_CH_IN[0].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= SpdCalcOK(*TRUE*));
		oDatDDT.CPT_CH_IN[1].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= SpdCalcOK(*TRUE*));

	1:	(* The following is default settings to the BS1 project: 
		Ch0 = Frequency Measuring Mode (1)
		Ch1 = Modulo Loop Counting Mode (7) *)
		oDatDDT.CPT_CH_IN[0].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := 0); 
		oDatDDT.CPT_CH_IN[0].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP := FrqSP_UDINT);

		oDatDDT.CPT_CH_IN[1].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := 0 );
		oDatDDT.CPT_CH_IN[1].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP :=  PlsCnt);

		oDatDDT.CPT_CH_IN[2].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := 0 );
		oDatDDT.CPT_CH_IN[2].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP :=  FrqSP_UDINT);

		oDatDDT.CPT_CH_IN[3].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := 0 );
		oDatDDT.CPT_CH_IN[3].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP :=  PlsCnt);

		oDatDDT.CPT_CH_IN[4].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := 0 );
		oDatDDT.CPT_CH_IN[4].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP :=  FrqSP_UDINT);

		oDatDDT.CPT_CH_IN[5].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := 0 );
		oDatDDT.CPT_CH_IN[5].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP :=  PlsCnt);

		oDatDDT.CPT_CH_IN[6].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := 0 );
		oDatDDT.CPT_CH_IN[6].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP :=  FrqSP_UDINT);

		oDatDDT.CPT_CH_IN[7].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := 0 );
		oDatDDT.CPT_CH_IN[7].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP :=  PlsCnt);

		(* Channel A/B Input *)
		oDatDDT.CPT_CH_IN[0].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= PlsOnTrig ) ;
		oDatDDT.CPT_CH_IN[0].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= 0) ;

		oDatDDT.CPT_CH_IN[1].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= PlsOnTrig) ;
		oDatDDT.CPT_CH_IN[1].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= 0) ;

		oDatDDT.CPT_CH_IN[2].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= PlsOnTrig ) ;
		oDatDDT.CPT_CH_IN[2].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= 0) ;

		oDatDDT.CPT_CH_IN[3].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= PlsOnTrig) ;
		oDatDDT.CPT_CH_IN[3].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= 0) ;

		oDatDDT.CPT_CH_IN[4].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= PlsOnTrig ) ;
		oDatDDT.CPT_CH_IN[4].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= 0) ;

		oDatDDT.CPT_CH_IN[5].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= PlsOnTrig) ;
		oDatDDT.CPT_CH_IN[5].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= 0) ;

		oDatDDT.CPT_CH_IN[6].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= PlsOnTrig ) ;
		oDatDDT.CPT_CH_IN[6].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= 0) ;

		oDatDDT.CPT_CH_IN[7].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= PlsOnTrig) ;
		oDatDDT.CPT_CH_IN[7].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= 0) ;

		(* Channel Set Valid *)
		oDatDDT.CPT_CH_IN[0].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= NOT(iCh0CntFlt));
		oDatDDT.CPT_CH_IN[1].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= NOT(iCh1CntFlt));
		oDatDDT.CPT_CH_IN[2].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= NOT(iCh0CntFlt));
		oDatDDT.CPT_CH_IN[3].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= NOT(iCh1CntFlt));
		oDatDDT.CPT_CH_IN[4].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= NOT(iCh0CntFlt));
		oDatDDT.CPT_CH_IN[5].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= NOT(iCh1CntFlt));
		oDatDDT.CPT_CH_IN[6].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= NOT(iCh0CntFlt));
		oDatDDT.CPT_CH_IN[7].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= NOT(iCh1CntFlt));

	(* 2: NOT PROGRAMMED*)

	ELSE(* Custom mode, write directly to iChannel Inputs (without speed calcs) *)
		(* Logic can be done outside the block, or completed here for different modes *)
		oDatDDT.CPT_CH_IN[0].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := (iCh0SignedCounter)); 
		oDatDDT.CPT_CH_IN[0].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP := DINT_TO_UDINT (IN := iCh0UnSignedCounter));

		oDatDDT.CPT_CH_IN[1].COUNTER_CURRENT_VALUE_S 	:= WRITE_INPUT_DINT 	(INP := iCh1SignedCounter );
		oDatDDT.CPT_CH_IN[1].COUNTER_CURRENT_VALUE_US 	:= WRITE_INPUT_UDINT 	(INP := DINT_TO_UDINT (IN := iCh0UnSignedCounter));

		(* Channel A/B Input *)
		oDatDDT.CPT_CH_IN[0].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= iCh0InA ) ;
		oDatDDT.CPT_CH_IN[0].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= iCh0InB) ;

		oDatDDT.CPT_CH_IN[1].ST_INPUT_A	:= WRITE_INPUT_EBOOL( INP:= iCh1InA) ;
		oDatDDT.CPT_CH_IN[1].ST_INPUT_B	:= WRITE_INPUT_EBOOL( INP:= iCh1InB) ;

		(* Channel Set Valid *)
		oDatDDT.CPT_CH_IN[0].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= NOT(iCh0CntFlt));
		oDatDDT.CPT_CH_IN[1].COUNTER_STATUS.3 := WRITE_INPUT_EBOOL (INP:= NOT(iCh1CntFlt));

	END_CASE;


	(* ===== Module &amp; Channel Faults ===== *)
	oDatDDT.MOD_HEALTH		:= WRITE_INPUT_EBOOL (INP:= NOT(iFlt));

	oDatDDT.MOD_FLT.0		:= WRITE_INPUT_EBOOL (INP:= (iFlt));
							
	oDatDDT.CPT_CH_IN[0].CH_HEALTH 	:= WRITE_INPUT_EBOOL (INP :=  NOT(iCh0Flt));
	oDatDDT.CPT_CH_IN[1].CH_HEALTH 	:= WRITE_INPUT_EBOOL (INP :=  NOT(iCh1Flt));

END_IF;
</STSource>
		</FBProgram>
	</FBSource>
