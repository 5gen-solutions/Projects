				<comment>Pulse Sequence Frequency (Hz)</comment>
				<attribute name="PositionPin" value="22"></attribute>
			</variables>
			<variables name="iPlsCntRst" typeName="EBOOL">
				<comment>Pulse Sequence Pulse Count Reset</comment>
				<attribute name="PositionPin" value="23"></attribute>
			</variables>
			<variables name="iCh0InA" typeName="EBOOL">
				<comment>Ch0 Input A</comment>
				<attribute name="PositionPin" value="25"></attribute>
			</variables>
			<variables name="iCh0InB" typeName="EBOOL">
				<comment>Ch0 Input B</comment>
				<attribute name="PositionPin" value="26"></attribute>
			</variables>
			<variables name="iCh1InA" typeName="EBOOL">
				<comment>Ch1 Input A</comment>
				<attribute name="PositionPin" value="27"></attribute>
			</variables>
